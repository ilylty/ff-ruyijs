+// ---------------------------------------------------------------------------
+// Dynamic code (eval / Function / Wasm)
+// ---------------------------------------------------------------------------
+
+namespace {
+
+FILE* EvalHandle() {
+  static FILE* file = []() -> FILE* {
+    const char* path = std::getenv("RUYIJS_DOM_EVAL_TRACE");
+    return path && *path ? std::fopen(path, "ab") : nullptr;
+  }();
+  return file;
+}
+
+// SHA-256 is computed here so the record carries the same content identity as
+// ruyitrace's; the compiler-side digest is not reachable from this hook.
+std::string Sha256Hex(const char* data, size_t length) {
+  static const uint32_t k[64] = {
+      0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1,
+      0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
+      0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786,
+      0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+      0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147,
+      0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
+      0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b,
+      0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+      0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a,
+      0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
+      0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2};
+  uint32_t h[8] = {0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
+                   0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19};
+  auto rotr = [](uint32_t x, int n) { return (x >> n) | (x << (32 - n)); };
+  const size_t total = length + 1 + 8;
+  const size_t blocks = (total + 63) / 64;
+  std::vector<unsigned char> buffer(blocks * 64, 0);
+  if (length) std::memcpy(buffer.data(), data, length);
+  buffer[length] = 0x80;
+  const uint64_t bits = static_cast<uint64_t>(length) * 8;
+  for (int i = 0; i < 8; ++i) {
+    buffer[blocks * 64 - 1 - i] = static_cast<unsigned char>((bits >> (8 * i)) & 0xff);
+  }
+  for (size_t b = 0; b < blocks; ++b) {
+    uint32_t w[64];
+    for (int i = 0; i < 16; ++i) {
+      const unsigned char* p = &buffer[b * 64 + i * 4];
+      w[i] = (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) |
+             (uint32_t(p[2]) << 8) | uint32_t(p[3]);
+    }
+    for (int i = 16; i < 64; ++i) {
+      const uint32_t s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >> 3);
+      const uint32_t s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >> 10);
+      w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+    }
+    uint32_t a = h[0], bb = h[1], c = h[2], d = h[3];
+    uint32_t e = h[4], f = h[5], g = h[6], hh = h[7];
+    for (int i = 0; i < 64; ++i) {
+      const uint32_t s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
+      const uint32_t ch = (e & f) ^ (~e & g);
+      const uint32_t t1 = hh + s1 + ch + k[i] + w[i];
+      const uint32_t s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
+      const uint32_t maj = (a & bb) ^ (a & c) ^ (bb & c);
+      const uint32_t t2 = s0 + maj;
+      hh = g; g = f; f = e; e = d + t1;
+      d = c; c = bb; bb = a; a = t1 + t2;
+    }
+    h[0] += a; h[1] += bb; h[2] += c; h[3] += d;
+    h[4] += e; h[5] += f; h[6] += g; h[7] += hh;
+  }
+  char out[65];
+  for (int i = 0; i < 8; ++i) {
+    std::snprintf(out + i * 8, 9, "%08x", h[i]);
+  }
+  return std::string(out, 64);
+}
+
+}  // namespace
+
+void TraceDynamicCode(JSContext* cx, JS::RuntimeCode kind,
+                      JS::Handle<JSString*> codeString,
+                      JS::CompilationType compilationType,
+                      JS::Handle<JSString*> bodyString) {
+  ProDynamicCodeHook(cx, kind, compilationType, codeString, bodyString);
+  FILE* file = EvalHandle();
+  if (!file) {
+    return;
+  }
+  // For Function the parameter list and the body are separate strings; the body
+  // is the code that matters and matches ruyitrace's `length`/`head`.
+  JS::RootedString text(cx, bodyString ? bodyString : codeString);
+  if (!text) {
+    text.set(codeString);
+  }
+  if (!text) {
+    return;
+  }
+  JS::UniqueChars utf8 = JS_EncodeStringToUTF8(cx, text);
+  if (!utf8) {
+    JS_ClearPendingException(cx);
+    return;
+  }
+  const size_t length = std::strlen(utf8.get());
+  const std::string digest = Sha256Hex(utf8.get(), length);
+
+  const char* kindName = "eval-indirect";
+  switch (compilationType) {
+    case JS::CompilationType::DirectEval: kindName = "eval-direct"; break;
+    case JS::CompilationType::IndirectEval: kindName = "eval-indirect"; break;
+    case JS::CompilationType::Function: kindName = "function"; break;
+    default: break;
+  }
+  if (kind != JS::RuntimeCode::JS) {
+    kindName = kind == JS::RuntimeCode::WASM ? "wasm" : "other";
+  }
+
+  static uint64_t seq = 0;
+  std::string record;
+  record.reserve(length < 256 ? 512 + length : 512);
+  char head[128];
+  std::snprintf(head, sizeof(head),
+                "{\"seq\":%llu,\"ts\":%lld,\"pid\":%lld,\"process_type\":\"tab\","
+                "\"type\":\"dynamicCode\",\"kind\":",
+                static_cast<unsigned long long>(seq++),
+                static_cast<long long>(RecordTs()), CurrentPid());
+  record.append(head);
+  AppendJsonString(&record, kindName);
+  record.append(",\"phase\":\"compile\",\"file\":");
+  // ruyitrace also dumps the source to a side file; the name only has to be
+  // stable per record, so it is derived from the same identity fields.
+  char fileName[96];
+  std::snprintf(fileName, sizeof(fileName), "eval_%lld_%llu_%s.js", CurrentPid(),
+                static_cast<unsigned long long>(seq - 1), kindName);
+  AppendJsonString(&record, fileName);
+  char sizes[96];
+  std::snprintf(sizes, sizeof(sizes), ",\"length\":%lld,\"head\":",
+                static_cast<long long>(length));
+  record.append(sizes);
+  // head is the leading source text, matching ruyitrace's 200-byte sample.
+  AppendJsonString(&record, utf8.get(), length > 200 ? 200 : length);
+  record.append(",\"sha256\":");
+  AppendJsonString(&record, digest.c_str());
+  record.append(",\"ok\":true,\"error\":null,\"stack\":[]}\n");
+  Emit(file, record);
+}
+
