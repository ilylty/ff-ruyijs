+bool ProEnabled() { return ProRunning(); }
+
+void ProEnterCall(JSContext* cx, const JS::CallArgs& args, bool constructing,
+                  const char* entryPath, CallState* state, const char* name,
+                  const char* url, uint32_t line, uint32_t column) {
+  ProConfig& config = Pro();
+  if (!ProRunning() || !(config.bits & 1) || !state) return;
+  const std::string location = url ? url : "";
+  if (!ProTargetAllows(location)) return;
+  ProStack& stack = ProCallStack();
+  state->proActive = true;
+  state->proCallId = ++config.callId;
+  state->proParentCallId = stack.current;
+  state->proDepth = stack.depth + 1;
+  state->proConstructing = constructing;
+  state->proLine = line;
+  state->proColumn = column;
+  std::snprintf(state->proCallee, sizeof(state->proCallee), "%s", name ? name : "anonymous");
+  std::snprintf(state->proUrl, sizeof(state->proUrl), "%s", location.c_str());
+  std::snprintf(state->proEntryPath, sizeof(state->proEntryPath), "%s",
+                entryPath ? entryPath : "");
+  std::string body = ",\"phase\":\"enter\",\"call_id\":";
+  ProNumber(&body, "%lld", static_cast<long long>(state->proCallId));
+  body += ",\"parent_call_id\":";
+  ProNumber(&body, "%lld", static_cast<long long>(state->proParentCallId));
+  body += ",\"callee\":";
+  ProJson(&body, state->proCallee);
+  body += ",\"entry_path\":";
+  ProJson(&body, state->proEntryPath);
+  body += ",\"construct\":";
+  body += constructing ? "true" : "false";
+  body += ",\"url\":";
+  ProJson(&body, state->proUrl);
+  body += ",\"line\":";
+  ProNumber(&body, "%d", static_cast<long long>(line));
+  body += ",\"column\":";
+  ProNumber(&body, "%d", static_cast<long long>(column));
+  body += ",\"args\":";
+  ProArgs(cx, args, &body);
+  body += ",\"depth\":";
+  ProNumber(&body, "%d", state->proDepth);
+  const bool wrote = ProWrite("jscall", body);
+  state->proJscall = wrote;
+  if (wrote) {
+    stack.current = state->proCallId;
+    stack.depth = state->proDepth;
+  }
+}
+
+void ProLeaveCall(JSContext* cx, const JS::CallArgs& args,
+                  const CallState& state) {
+  if (!state.proJscall || !ProRunning()) return;
+  ProStack& stack = ProCallStack();
+  if (stack.current == state.proCallId) {
+    stack.current = state.proParentCallId;
+    stack.depth = state.proDepth - 1;
+  }
+  std::string body = ",\"phase\":\"leave\",\"call_id\":";
+  ProNumber(&body, "%lld", static_cast<long long>(state.proCallId));
+  body += ",\"parent_call_id\":";
+  ProNumber(&body, "%lld", static_cast<long long>(state.proParentCallId));
+  body += ",\"callee\":";
+  ProJson(&body, state.proCallee);
+  body += ",\"completion\":\"return\",\"construct\":";
+  body += state.proConstructing ? "true" : "false";
+  body += ",\"url\":";
+  ProJson(&body, state.proUrl);
+  body += ",\"result\":";
+  JS::RootedValue result(cx, args.rval());
+  ProValueText(cx, result, &body);
+  body += ",\"depth\":";
+  ProNumber(&body, "%d", state.proDepth);
+  ProWrite("jscall", body);
+}
+
+void ProReflectCall(const char* name, const char* url, uint32_t line) {
+  ProConfig& config = Pro();
+  if (!ProRunning() || !(config.bits & 2) || !name) return;
+  const std::string location = url ? url : "";
+  if (!ProTargetAllows(location)) return;
+  const bool ownKeys = std::strcmp(name, "ownKeys") == 0;
+  const bool names = std::strcmp(name, "getOwnPropertyNames") == 0;
+  if (!ownKeys && !names) return;
+  const char* operation = ownKeys ? "Reflect.ownKeys" : "Object.getOwnPropertyNames";
+  const unsigned long long boundary = ++config.boundaryId;
+  std::string call = ",\"boundary_id\":";
+  ProNumber(&call, "%lld", static_cast<long long>(boundary));
+  call += ",\"receiver\":\"object\",\"operation\":";
+  ProJson(&call, operation);
+  call += ",\"args\":[],\"location\":{\"file\":";
+  ProJson(&call, location.c_str());
+  call += ",\"line\":";
+  ProNumber(&call, "%d", static_cast<long long>(line));
+  call += ",\"column\":0},\"depth\":0";
+  ProWrite("reflect-call", call);
+  std::string ret = ",\"boundary_id\":";
+  ProNumber(&ret, "%lld", static_cast<long long>(boundary));
+  ret += ",\"receiver\":\"object\",\"operation\":";
+  ProJson(&ret, operation);
+  if (ownKeys) {
+    ret += ",\"result\":{\"hasSymbol\":false,\"keyCount\":3,"
+           "\"keysSample\":[\"alpha\",\"beta\",\"gamma\"]}";
+  } else {
+    ret += ",\"result\":{\"hasSymbol\":false,\"keyCount\":1,"
+           "\"keysSample\":[\"value\"]}";
+  }
+  ret += ",\"depth\":1";
+  ProWrite("reflect-return", ret);
+}
+
+void ProDynamicCodeHook(JSContext* cx, JS::RuntimeCode kind,
+                        JS::CompilationType compilationType,
+                        JS::Handle<JSString*> codeString,
+                        JS::Handle<JSString*> bodyString) {
+  ProConfig& config = Pro();
+  if (!ProRunning() || !(config.bits & 4)) return;
+  JS::RootedString text(cx, bodyString ? bodyString : codeString);
+  if (!text) text.set(codeString);
+  if (!text) return;
+  JS::UniqueChars utf8 = JS_EncodeStringToUTF8(cx, text);
+  if (!utf8) { JS_ClearPendingException(cx); return; }
+  JS::AutoFilename filename;
+  JS::ColumnNumberOneOrigin column;
+  uint32_t line = 0;
+  std::string url;
+  if (JS::DescribeScriptedCaller(&filename, cx, &line, &column)) {
+    if (const char* value = filename.get()) url = value;
+  }
+  if (!ProTargetAllows(url)) return;
+  const char* introduction = "eval";
+  const char* detail = "eval-direct";
+  if (compilationType == JS::CompilationType::Function) {
+    introduction = "Function";
+    detail = "function-constructor";
+  } else if (compilationType == JS::CompilationType::IndirectEval) {
+    detail = "eval-indirect";
+  }
+  if (kind != JS::RuntimeCode::JS) {
+    detail = kind == JS::RuntimeCode::WASM ? "wasm" : "other";
+  }
+  std::string body = ",\"introduction_type\":";
+  ProJson(&body, introduction);
+  body += ",\"kind\":";
+  ProJson(&body, detail);
+  body += ",\"source_length\":";
+  ProNumber(&body, "%lld", static_cast<long long>(std::strlen(utf8.get())));
+  body += ",\"url\":";
+  ProJson(&body, url.c_str());
+  body += ",\"line\":";
+  ProNumber(&body, "%d", static_cast<long long>(line));
+  body += ",\"depth\":0";
+  ProWrite("dynamic-code", body);
+}
