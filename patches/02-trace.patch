+++ b/js/src/vm/StandaloneTrace.cpp
@@ -0,0 +1,3408 @@
+// ruyijs standalone call tracing — implementation.
+//
+// WindowProxy association lives in vm/RuyijsWindowProxy.cpp so this trace
+// patch stays independent of the proxy fix.
+//
+// See StandaloneTrace.h for the contract. Records are JSON lines in ruyitrace's
+// jscall shape so a ruyijs trace and a ruyitrace trace can be diffed field by
+// field.
+//
+// Switches (mirroring ruyitrace's MOZ_DOM_* naming):
+//   RUYIJS_DOM_TRACE        output file; unset or empty disables tracing
+//   RUYIJS_DOM_TRACE_LIMIT  max records, 0 or unset = unlimited
+//   RUYIJS_DOM_JSCALL_ARGS  0 = omit arg_types / result_type (default: include)
+//
+// Records are assembled in memory and written with a single fwrite. Resolving a
+// callee's name or script position can re-enter JS (and therefore CallJSNative),
+// so writing "as we go" would interleave a nested record into the middle of an
+// outer one; buffering keeps every line atomic without suppressing nesting.
+
+#include "vm/StandaloneTrace.h"
+
+#include "mozilla/TimeStamp.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstdio>
+#include <cstdlib>
+#include <cmath>
+#include <cstring>
+#if defined(XP_WIN)
+#include <windows.h>
+#else
+#include <unistd.h>
+#endif
+#include <string>
+#include <set>
+#include <unordered_map>
+#include <vector>
+#include <atomic>
+#include <chrono>
+
+#include "js/CharacterEncoding.h"
+#include "js/PropertyAndElement.h"
+#include "js/Stack.h"
+#include "js/String.h"
+#include "jsapi.h"
+#include "vm/GlobalObject.h"
+#include "vm/EnvironmentObject.h"
+#include "jit/BaselineFrame.h"
+#include "vm/Activation.h"
+#include "vm/JSContext.h"
+#include "util/Text.h"
+#include "vm/BytecodeUtil.h"
+#include "vm/JSFunction.h"
+#include "vm/JSObject.h"
+#include "vm/JSScript.h"
+#include "vm/StringType.h"
+
+namespace js {
+namespace standalone_trace {
+namespace {
+
+// ---------------------------------------------------------------------------
+// Deferred heavy trace gate.
+//
+// opcode + jscall records are assembled per instruction / per call and flushed
+// with fflush, which makes a from-boot full trace ~70x slower than the light
+// families. Keeping the switches set at process start still compiles the
+// Baseline trampolines in (BaselineOpcodeEnabled() is evaluated at JIT compile
+// time), but the gate suppresses all serialisation and writes until armed.
+// ---------------------------------------------------------------------------
+int64_t NowMicros();  // defined below in this anonymous namespace
+
+std::atomic<bool> gHeavyArmed{true};
+std::atomic<bool> gHeavyChecked{false};
+std::atomic<int64_t> gHeavyArmedAt{0};
+
+void CheckHeavyGateOnce() {
+  if (gHeavyChecked.exchange(true)) return;
+  const char* mode = std::getenv("RUYIJS_TRACE_HEAVY");
+  if (mode && *mode && std::strcmp(mode, "off") == 0) {
+    gHeavyArmed.store(false);
+  }
+}
+
+int64_t ProcessStartMicros() {
+  static const int64_t start = NowMicros();
+  return start;
+}
+
+bool HeavyArmed() {
+  CheckHeavyGateOnce();
+  if (!gHeavyArmed.load()) {
+    const char* delay = std::getenv("RUYIJS_TRACE_HEAVY_DELAY_MS");
+    if (delay && *delay) {
+      const int64_t ms = static_cast<int64_t>(std::strtoll(delay, nullptr, 10));
+      if (ms >= 0 && NowMicros() - ProcessStartMicros() >= ms * 1000) {
+        gHeavyArmed.store(true);
+        gHeavyArmedAt.store(NowMicros());
+      }
+    }
+  }
+  if (gHeavyArmed.load()) {
+    const char* window = std::getenv("RUYIJS_TRACE_HEAVY_WINDOW_MS");
+    if (window && *window && gHeavyArmedAt.load() > 0) {
+      const int64_t ms = static_cast<int64_t>(std::strtoll(window, nullptr, 10));
+      if (ms >= 0 && NowMicros() - gHeavyArmedAt.load() > ms * 1000) {
+        gHeavyArmed.store(false);
+      }
+    }
+  }
+  return gHeavyArmed.load();
+}
+
+FILE* TraceHandle() {  static FILE* file = []() -> FILE* {
+    const char* path = std::getenv("RUYIJS_DOM_TRACE");
+    if (!path || !*path) {
+      return nullptr;
+    }
+    return std::fopen(path, "ab");
+  }();
+  return file;
+}
+
+// DOM/ruyitrace jscall cap. Pro standalone uses ProConfig::limit and
+// ProConfig::emitted; this value only counts DOM jscall records.
+uint64_t DomJscallLimit() {
+  static uint64_t limit = []() -> uint64_t {
+    const char* text = std::getenv("RUYIJS_DOM_TRACE_LIMIT");
+    if (!text || !*text) {
+      return 0;
+    }
+    return static_cast<uint64_t>(std::strtoull(text, nullptr, 10));
+  }();
+  return limit;
+}
+
+bool ArgsEnabled() {
+  static bool enabled = []() -> bool {
+    const char* text = std::getenv("RUYIJS_DOM_JSCALL_ARGS");
+    return !text || !*text || std::strcmp(text, "0") != 0;
+  }();
+  return enabled;
+}
+
+// RUYIJS_DOM_JSCALL_VALUES dumps the first few argument values verbatim, which
+// is what distinguishes an obfuscated VM calling with `undefined` from an
+// environment that supplied the expected value. Off by default: values can be
+// large objects and this calls into JS, so it is the slowest trace mode.
+bool ValuesEnabled() {
+  static bool enabled = []() -> bool {
+    const char* text = std::getenv("RUYIJS_DOM_JSCALL_VALUES");
+    return text && *text && std::strcmp(text, "0") != 0;
+  }();
+  return enabled;
+}
+
+// Depth of argument summarisation. 0 keeps every argument at its type name.
+int ValueDepth() {
+  static int depth = []() -> int {
+    const char* text = std::getenv("RUYIJS_DOM_JSCALL_VALUE_DEPTH");
+    if (!text || !*text) {
+      return 1;
+    }
+    return static_cast<int>(std::strtol(text, nullptr, 10));
+  }();
+  return depth;
+}
+
+long long CurrentPid() {
+#if defined(XP_WIN)
+  return static_cast<long long>(GetCurrentProcessId());
+#else
+  return static_cast<long long>(getpid());
+#endif
+}
+
+// Generic DOM/ruyitrace record sequence. Pro standalone JSONL uses
+// ProConfig::seq / emitted / limit in vm/StandaloneTracePro.cpp and never
+// consumes this counter.
+uint64_t NextDomSeq() {
+  static uint64_t seq = 0;
+  return seq++;
+}
+
+// The jscall cap has its own emitted-event counter. A pro-only call must not
+// advance this value, and a DOM-stream limit must not stop pro records.
+uint64_t& DomJscallSequence() {
+  static uint64_t seq = 0;
+  return seq;
+}
+
+// Only the file write itself needs to be non-reentrant; building the record
+// does not touch the sink.
+bool& Writing() {
+  static bool writing = false;
+  return writing;
+}
+
+void Emit(FILE* file, const std::string& record) {
+  // A record is assembled only when its own output file exists, but the two
+  // families share one hook site: the builtin path can run with only
+  // RUYIJS_CF_TRACE set, which leaves this file null.
+  if (!file || Writing()) {
+    return;
+  }
+  Writing() = true;
+  // L1: stamp the time base at emit time so no reader has to guess.
+  std::string stamped = record;
+  if (stamped.find("\"ts\":") != std::string::npos &&
+      stamped.find("\"ts_kind\"") == std::string::npos &&
+      stamped.size() > 1 && stamped[0] == '{') {
+    stamped.insert(1, "\"ts_kind\":\"epoch_ms\",");
+  }
+  std::fwrite(stamped.data(), 1, stamped.size(), file);
+  std::fflush(file);
+  Writing() = false;
+}
+
+// parent_call_id is the id of the frame that was innermost when this call
+// started.
+struct Stack {
+  uint64_t current = 0;
+  int32_t depth = 0;
+};
+
+Stack& CallStack() {
+  static Stack stack;
+  return stack;
+}
+
+int64_t NowMicros() {
+  return static_cast<int64_t>(
+      (mozilla::TimeStamp::Now() - mozilla::TimeStamp::ProcessCreation())
+          .ToMicroseconds());
+}
+
+// ruyitrace stamps domtrace records with epoch milliseconds, and its
+// trace_run_id is `<pid>-<same millis>`. The operator and timer records have to
+// use that clock or they cannot be ordered against ruyitrace's stream.
+int64_t NowEpochMillis() {
+  return static_cast<int64_t>(
+      std::chrono::duration_cast<std::chrono::milliseconds>(
+          std::chrono::system_clock::now().time_since_epoch()).count());
+}
+
+// L1: every emitted record uses this single epoch-ms clock.
+int64_t RecordTs() { return NowEpochMillis(); }
+
+void AppendJsonString(std::string* out, const char* data, size_t length) {
+  out->push_back('"');
+  for (size_t i = 0; i < length; ++i) {
+    unsigned char c = static_cast<unsigned char>(data[i]);
+    switch (c) {
+      case '"':
+        out->append("\\\"");
+        break;
+      case '\\':
+        out->append("\\\\");
+        break;
+      case '\n':
+        out->append("\\n");
+        break;
+      case '\r':
+        out->append("\\r");
+        break;
+      case '\t':
+        out->append("\\t");
+        break;
+      default:
+        if (c < 0x20) {
+          char buffer[8];
+          std::snprintf(buffer, sizeof(buffer), "\\u%04x", c);
+          out->append(buffer);
+        } else {
+          out->push_back(static_cast<char>(c));
+        }
+    }
+  }
+  out->push_back('"');
+}
+
+void AppendJsonString(std::string* out, const char* text) {
+  if (!text) {
+    out->append("\"\"");
+    return;
+  }
+  AppendJsonString(out, text, std::strlen(text));
+}
+
+// The callee's name, or null for anonymous functions.
+JS::UniqueChars CalleeName(JSContext* cx, JS::HandleObject callee) {
+  if (!callee->is<JSFunction>()) {
+    return nullptr;
+  }
+  JS::RootedFunction function(cx, &callee->as<JSFunction>());
+  JS::RootedString id(cx);
+  if (!JS_GetFunctionDisplayId(cx, function, &id) || !id) {
+    return nullptr;
+  }
+  return JS_EncodeStringToUTF8(cx, id);
+}
+
+// ruyitrace records engine builtins under the interface they belong to
+// (`Math.abs`, `Function.prototype.toString`, `JSON.parse`), because its hook sits
+// inside the JS engine rather than at the WebIDL boundary. ruyijs reaches the same
+// information from the callee alone: the global object names each builtin holder,
+// so a lookup of the callee under those holders recovers the interface name.
+//
+// Returns the holder's name, or nullptr when the callee is not a builtin member.
+// The scan is bounded: only the holders ruyitrace actually reports are probed, and
+// each probe is a single own-property read.
+JS::UniqueChars BuiltinInterface(JSContext* cx, JS::HandleObject callee,
+                                 const char* memberName) {
+  if (!callee->is<JSFunction>()) {
+    return nullptr;
+  }
+  const bool hasName = memberName && *memberName;
+  static const char* const kHolders[] = {
+      "Math",        "JSON",   "Object", "Function", "String",
+      "Number",      "Boolean", "Array",  "Symbol",   "Date",
+      "RegExp",      "Promise", "Reflect", "Intl",    "BigInt",
+      "Map",         "Set",    "WeakMap", "WeakSet", "WeakRef",
+      "ArrayBuffer", "Uint8Array", "Error",  "Proxy",   "Atomics",
+      "BigInt64Array", "Uint32Array", "Float64Array", "DataView",
+      "parseInt",    "parseFloat", "isNaN", "isFinite",
+  };
+
+  JS::RootedObject global(cx, JS::CurrentGlobalOrNull(cx));
+  if (!global) {
+    return nullptr;
+  }
+  JS::RootedValue holderValue(cx);
+
+  // Own-property reads throughout: JS_GetProperty walks the prototype chain, which
+  // would report `Math.toString` and `Object.toString` for what is really
+  // `Object.prototype.toString` on every holder it is reachable from.
+  auto ownMember = [&](JS::HandleObject object, const char* key,
+                       JS::MutableHandleValue out) -> bool {
+    JS::RootedId id(cx);
+    JS::RootedString name(cx, JS_NewStringCopyZ(cx, key));
+    if (!name || !JS_StringToId(cx, name, &id)) {
+      JS_ClearPendingException(cx);
+      return false;
+    }
+    JS::Rooted<mozilla::Maybe<JS::PropertyDescriptor>> descriptor(cx);
+    if (!JS_GetOwnPropertyDescriptorById(cx, object, id, &descriptor)) {
+      JS_ClearPendingException(cx);
+      return false;
+    }
+    if (descriptor.isNothing()) {
+      return false;
+    }
+    out.set(descriptor->value());
+    return true;
+  };
+  JS::RootedObject holderObject(cx);
+  JS::RootedValue candidate(cx);
+  for (const char* holder : kHolders) {
+    JS::RootedValue rawHolder(cx);
+    if (!JS_GetProperty(cx, global, holder, &rawHolder)) {
+      JS_ClearPendingException(cx);
+      continue;
+    }
+    if (!rawHolder.isObject()) {
+      continue;
+    }
+    holderObject = &rawHolder.toObject();
+    // The constructor itself: `new Map()` has Map as callee, and Map is the
+    // holder, not a member of it. ruyitrace names these `<Holder>.<Holder>`.
+    if (holderObject == callee) {
+      JS::RootedString name(cx, JS_NewStringCopyZ(cx, holder));
+      return name ? JS_EncodeStringToUTF8(cx, name) : nullptr;
+    }
+    JS::RootedValue protoValue(cx);
+    if (hasName && ownMember(holderObject, "prototype", &protoValue) &&
+        protoValue.isObject()) {
+      JS::RootedObject proto(cx, &protoValue.toObject());
+      if (ownMember(proto, memberName, &candidate) &&
+          &candidate.toObject() == callee) {
+        std::string qualified(holder);
+        qualified += ".prototype";
+        const bool keepQualified = qualified == "Object.prototype";
+        JS::RootedString name(
+            cx, JS_NewStringCopyZ(cx, keepQualified ? qualified.c_str() : holder));
+        return name ? JS_EncodeStringToUTF8(cx, name) : nullptr;
+      }
+    }
+    if (hasName && ownMember(holderObject, memberName, &candidate) &&
+        &candidate.toObject() == callee) {
+      JS::RootedString holderText(cx, JS_NewStringCopyZ(cx, holder));
+      return holderText ? JS_EncodeStringToUTF8(cx, holderText) : nullptr;
+    }
+  }
+  return nullptr;
+}
+
+// Recovers the member name for a builtin whose display id is empty. Self-hosted
+// builtins such as Function.prototype.toString have no display id, but ruyitrace
+// still names them, so the holder's own members are scanned for a pointer match.
+JS::UniqueChars BuiltinMemberFor(JSContext* cx, JS::HandleObject callee,
+                                 JS::HandleObject holderObject) {
+  // JS_Enumerate reports enumerable keys only; builtin prototype methods such as
+  // Function.prototype.toString are non-enumerable, so the own-name list is used.
+  JS::RootedIdVector ids(cx);
+  if (!js::GetPropertyKeys(cx, holderObject, JSITER_OWNONLY | JSITER_HIDDEN, &ids)) {
+    JS_ClearPendingException(cx);
+    return nullptr;
+  }
+  JS::RootedValue candidate(cx);
+  for (const auto& rawId : ids) {
+    JS::RootedId id(cx, rawId);
+    JS::RootedValue key(cx);
+    if (!JS_IdToValue(cx, id, &key)) {
+      JS_ClearPendingException(cx);
+      continue;
+    }
+    // Symbol-keyed members are not addressable by the names ruyitrace reports.
+    if (!key.isString()) {
+      continue;
+    }
+    JS::RootedString keyText(cx, key.toString());
+    JS::UniqueChars utf8 = keyText ? JS_EncodeStringToUTF8(cx, keyText) : nullptr;
+    if (!utf8) {
+      JS_ClearPendingException(cx);
+      continue;
+    }
+    JS::Rooted<mozilla::Maybe<JS::PropertyDescriptor>> descriptor(cx);
+    if (!JS_GetOwnPropertyDescriptorById(cx, holderObject, id, &descriptor)) {
+      JS_ClearPendingException(cx);
+      continue;
+    }
+    if (descriptor.isNothing() || !descriptor->value().isObject()) {
+      continue;
+    }
+    if (&descriptor->value().toObject() == callee) {
+      return utf8;
+    }
+  }
+  return nullptr;
+}
+
+// Where the callee is defined. Interpreted functions answer from their script;
+// native and bound functions have none, so the JS caller is reported instead.
+// Resolves both ends of the call. For an interpreted callee the script gives
+// its own position; the caller always comes from the running frame, which is
+// what lets a trace be turned back into a call tree.
+struct CallPositions {
+  JS::UniqueChars calleeUrl;
+  uint32_t calleeLine = 0;
+  uint32_t calleeColumn = 0;
+  JS::UniqueChars callerUrl;
+  uint32_t callerLine = 0;
+  uint32_t callerColumn = 0;
+};
+
+void ResolvePositions(JSContext* cx, JS::HandleObject callee, CallPositions* out) {
+  if (callee->is<JSFunction>()) {
+    JS::RootedFunction function(cx, &callee->as<JSFunction>());
+    if (function->isInterpreted() && !function->isSelfHostedBuiltin()) {
+      JSScript* raw = function->nonLazyScript();
+      if (raw) {
+        JS::RootedScript script(cx, raw);
+        out->calleeLine = script->lineno();
+        // JSScript stores 1-origin columns; ruyitrace reports 0-origin.
+        out->calleeColumn = script->column().oneOriginValue() - 1;
+        if (const char* name = script->filename()) {
+          out->calleeUrl = DuplicateString(cx, name);
+        }
+      }
+    }
+  }
+  JS::AutoFilename filename;
+  JS::ColumnNumberOneOrigin callerColumn;
+  uint32_t callerLine = 0;
+  if (JS::DescribeScriptedCaller(&filename, cx, &callerLine, &callerColumn)) {
+    if (const char* name = filename.get()) {
+      out->callerUrl = DuplicateString(cx, name);
+    }
+    out->callerLine = callerLine;
+    out->callerColumn = callerColumn.oneOriginValue() - 1;
+  }
+  // A native callee has no script of its own; its only addressable position is
+  // the caller's, so mirror it rather than reporting zeros.
+  if (!out->calleeUrl && out->callerUrl) {
+    out->calleeLine = out->callerLine;
+    out->calleeColumn = out->callerColumn;
+  }
+}
+
+void CalleePosition(JSContext* cx, JS::HandleObject callee, JS::UniqueChars* url,
+                    uint32_t* line, uint32_t* column) {
+  *line = 0;
+  *column = 0;
+  if (callee->is<JSFunction>()) {
+    JS::RootedFunction function(cx, &callee->as<JSFunction>());
+    if (function->isInterpreted() && !function->isSelfHostedBuiltin()) {
+      JSScript* raw = function->nonLazyScript();
+      if (raw) {
+        JS::RootedScript script(cx, raw);
+        *line = script->lineno();
+        // JSScript stores 1-origin columns; ruyitrace reports 0-origin.
+        *column = script->column().oneOriginValue() - 1;
+        if (const char* name = script->filename()) {
+          *url = DuplicateString(cx, name);
+        }
+        return;
+      }
+    }
+  }
+  JS::AutoFilename filename;
+  JS::ColumnNumberOneOrigin callerColumn;
+  uint32_t callerLine = 0;
+  if (JS::DescribeScriptedCaller(&filename, cx, &callerLine, &callerColumn)) {
+    if (const char* name = filename.get()) {
+      *url = DuplicateString(cx, name);
+    }
+    *line = callerLine;
+    *column = callerColumn.oneOriginValue() - 1;
+  }
+}
+
+// Compact type code used to carry an argument or result type across the call
+// boundary without holding a JS::Value.
+char ValueTypeCode(const JS::Value& value) {
+  if (value.isUndefined()) return 'u';
+  if (value.isNull()) return 'n';
+  if (value.isBoolean()) return 'b';
+  if (value.isInt32()) return 'i';
+  if (value.isDouble()) return 'd';
+  if (value.isString()) return 's';
+  if (value.isSymbol()) return 'y';
+  if (value.isBigInt()) return 'g';
+  if (value.isObject()) return 'o';
+  return '?';
+}
+
+const char* TypeNameFromCode(char code) {
+  switch (code) {
+    case 'u': return "undefined";
+    case 'n': return "null";
+    case 'b': return "boolean";
+    case 'i': return "int32";
+    case 'd': return "double";
+    case 's': return "string";
+    case 'y': return "symbol";
+    case 'g': return "bigint";
+    case 'o': return "object";
+    default: return "unknown";
+  }
+}
+
+const char* ValueTypeName(const JS::Value& value) {
+  if (value.isUndefined()) {
+    return "undefined";
+  }
+  if (value.isNull()) {
+    return "null";
+  }
+  if (value.isBoolean()) {
+    return "boolean";
+  }
+  if (value.isInt32()) {
+    return "int32";
+  }
+  if (value.isDouble()) {
+    return "double";
+  }
+  if (value.isString()) {
+    return "string";
+  }
+  if (value.isSymbol()) {
+    return "symbol";
+  }
+  if (value.isBigInt()) {
+    return "bigint";
+  }
+  if (value.isObject()) {
+    return "object";
+  }
+  return "unknown";
+}
+
+void AppendNumber(std::string* out, const char* format, long long value) {
+  char buffer[32];
+  std::snprintf(buffer, sizeof(buffer), format, value);
+  out->append(buffer);
+}
+
+// A capped stream stops silently, which makes a truncated log look complete.
+// ruyitrace closes such a stream with one limit_reached record naming the cap, so
+// the reader can tell the difference; this repeats that.
+void EmitLimitReached(FILE* file, const char* scope, uint64_t limit) {
+  if (!file) {
+    return;
+  }
+  // Only the transition into the capped state is worth reporting; every record
+  // past the cap sees the same condition.
+  static std::set<std::string> reported;
+  if (!reported.insert(scope).second) {
+    return;
+  }
+  std::string record;
+  record.reserve(128);
+  record.append("{\"seq\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(NextDomSeq()));
+  record.append(",\"pid\":");
+  AppendNumber(&record, "%d", static_cast<long long>(CurrentPid()));
+  record.append(",\"type\":\"limit_reached\",\"scope\":");
+  AppendJsonString(&record, scope);
+  record.append(",\"limit\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(limit));
+  record.append("}\n");
+  Emit(file, record);
+}
