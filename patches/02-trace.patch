+
diff --git a/js/src/vm/StandaloneTrace.h b/js/src/vm/StandaloneTrace.h
new file mode 100644
index 0000000000..9ad2a91379
--- /dev/null
+++ b/js/src/vm/StandaloneTrace.h
@@ -0,0 +1,246 @@
+// ruyijs standalone call tracing.
+//
+// ruyijs expects a donor SpiderMonkey that provides this header: its
+// runtime/standalone_trace.h probes for vm/StandaloneTrace.h and, when it
+// exists, routes every observed host call through EnterCall/LeaveCall instead
+// of compiling a stub. The published ff-ruyijs tree does not ship this file, so
+// this is a reimplementation of the contract it documents:
+//
+//   namespace js::standalone_trace {
+//     struct CallState;
+//     enum class Category { Ruyijs, ... };
+//     bool IsEnabled(Category);
+//     void EnterCall(JSContext*, const JS::CallArgs&, bool constructing,
+//                    const char* entryPath, CallState*);
+//     void LeaveCall(JSContext*, const JS::CallArgs&, const CallState&, bool ok);
+//     bool DefineRuyijsObject(JSContext*, JS::HandleObject holder);
+//   }
+//
+// The record shape follows ruyitrace's jscall schema so both traces can be
+// diffed: call_id / parent_call_id / depth / callee_name / callee_url /
+// callee_line / caller_url / caller_line / argc / arg_types / result_type /
+// duration_us.
+//
+// Enable with RUYIJS_DOM_TRACE=<file>. RUYIJS_DOM_TRACE_LIMIT bounds records
+// (0 = unlimited), matching ruyitrace's MOZ_DOM_TRACE / MOZ_DOM_TRACE_LIMIT
+// pairing.
+
+#ifndef js_vm_StandaloneTrace_h
+#define js_vm_StandaloneTrace_h
+
+#include "mozilla/Maybe.h"
+
+#include <cstdint>
+
+#include "js/CallArgs.h"
+#include "js/Principals.h"
+#include "js/TypeDecls.h"
+
+class JS_PUBLIC_API JSContext;
+class JSScript;
+using jsbytecode = unsigned char;
+
+namespace js {
+class InterpreterFrame;
+namespace standalone_trace {
+
+// ruyitrace groups its switches by category; ruyijs only ever asks about
+// Ruyijs, but the enum is part of the contract.
+enum class Category { Ruyijs, Dom, Network };
+
+// Per-call bookkeeping. Cheap to copy out of, never heap-allocated by callers.
+struct CallState {
+  uint64_t callId = 0;
+  uint64_t parentCallId = 0;
+  uint64_t rawParentCallId = 0;
+  int32_t depth = 0;
+  int32_t parentOmittedDepth = 0;
+  int64_t startMicros = 0;
+  bool active = false;
+  // Identity of the callee, captured at entry so the exit record can repeat it
+  // without touching the (possibly collected) object again.
+  char calleeIdentity[24] = {};
+  char calleeObjectId[24] = {};
+  const char* calleeKind = "";
+  const char* calleeIdentityKind = "";
+  const char* calleeObjectClass = "";
+  const char* calleeValueType = "";
+  const char* parentStatus = "root";
+  const char* parentElideReason = "";
+  bool isCallable = false;
+  bool isJsFunction = false;
+  bool isProxy = false;
+  // Everything the completed record needs, captured at enter: resolving these at
+  // exit would re-enter JS after the callee may already be unreachable.
+  char calleeName[128] = {};
+  char calleeUrl[512] = {};
+  char callerUrl[512] = {};
+  int32_t calleeLine = 0;
+  int32_t calleeColumn = 0;
+  int32_t callerLine = 0;
+  int32_t callerColumn = 0;
+  size_t argc = 0;
+  bool constructing = false;
+  const char* entryPath = "";
+  // Argument and result types, packed as one character per slot so the exit
+  // record can repeat them without touching any JS values.
+  char argTypes[16] = {};
+  int32_t argTypeCount = 0;
+  // Pro standalone trace state. It has its own call tree, so switching the
+  // RUYIJS_DOM_* stream on or off cannot change pro parent/child links.
+  bool proActive = false;
+  bool proJscall = false;
+  bool proReflect = false;
+  uint64_t proCallId = 0;
+  uint64_t proParentCallId = 0;
+  uint64_t proBoundaryId = 0;
+  int32_t proDepth = 0;
+  uint32_t proLine = 0;
+  uint32_t proColumn = 0;
+  bool proConstructing = false;
+  char proCallee[128] = {};
+  char proUrl[512] = {};
+  char proEntryPath[32] = {};
+  char proOperation[80] = {};
+};
+
+bool IsEnabled(Category category);
+
+void EnterCall(JSContext* cx, const JS::CallArgs& args, bool constructing,
+               const char* entryPath, CallState* state);
+
+void LeaveCall(JSContext* cx, const JS::CallArgs& args, const CallState& state,
+               bool ok);
+
+// Defines the page's `ruyijs` helper object on |holder|.
+bool DefineRuyijsObject(JSContext* cx, JS::HandleObject holder);
+
+// One interpreter dispatch step. Called from ADVANCE_AND_DISPATCH in
+// Interpreter.cpp; a no-op unless RUYIJS_DOM_OPCODE names an output file.
+void TraceOpcode(JSContext* cx, JSScript* script, jsbytecode* pc,
+                 JS::Value* sp, uint32_t stackDepth, InterpreterFrame* frame);
+
+// WASM layer. ruyitrace records one document per stage of a module's life
+// (compile, import resolution, instantiate, exports read) when
+// RUYIJS_DOM_WASM_TRACE names an output file. The hook lives here rather than in
+// the host layer because WebAssembly is the engine's own object: the page has no
+// separate shim to instrument.
+// Counts that only the module metadata knows, so a record does not have to infer
+// them from the exports object.
+struct WasmCounts {
+  uint32_t exportsCount = 0;
+  uint32_t funcCount = 0;
+  uint32_t memoryCount = 0;
+  uint32_t tableCount = 0;
+  uint32_t globalCount = 0;
+  uint32_t tagCount = 0;
+  bool truncated = false;
+};
+
+void TraceWasmBytes(JSContext* cx, const uint8_t* bytes, size_t length,
+                    const char* api, const char* op, const char* phase);
+// A console call is reported with the arguments still live, because ruyitrace
+// keeps one entry per argument rather than a single joined string. The caller
+// site is read here too: at this point the console frame is still on the stack.
+void TraceConsoleCall(JSContext* cx, const char* method, JS::CallArgs& args);
+void TraceWasmModule(JSContext* cx, const void* module, const char* api,
+                     const char* op, const char* phase);
+// A compile or instantiate reports twice: once when the work starts, and once
+// when the module exists and its section counts are known.
+void TraceWasmComplete(JSContext* cx, const void* module, const char* api,
+                       const char* op, const char* phase,
+                       const WasmCounts& counts);
+// Reading Instance.exports is its own stage in ruyitrace's document, because that
+// is where the caller learns which exports exist. The record carries the export
+// names and their kinds.
+void TraceWasmExports(JSContext* cx, JS::HandleObject exports, const char* api);
+// Import resolution completes when the instance becomes usable, which is the one
+// moment both the resolved import set and the exports exist.
+void TraceWasmResolve(JSContext* cx, uint32_t importsCount,
+                      const WasmCounts& counts, JS::HandleObject exports);
+// Baseline interpreter half of the opcode layer. ruyitrace reports ops from both
+// the C++ interpreter and the Baseline interpreter, tagging each record with a
+// `tier`; a trace hooked only on the C++ side loses everything a hot script
+// runs. BaselineCodeGen calls these from the per-op epilogue it emits.
+bool BaselineOpcodeEnabled();
+void BaselineOpcodeTrampoline(void* script, void* pc, int32_t op);
+// Two-argument form: the op is read from the bytecode pc, which saves a register
+// for call sites that have none to spare.
+void BaselineOpcodeTrampoline2(void* script, void* pc);
+// Variant for the shared Baseline interpreter loop: it emits one body for every
+// script, so the running script has to be resolved at run time.
+void BaselineLoopOpcodeTrampoline(void* pc, int32_t op);
+// VM (JSVMP) recognizer. The opcode stream alone is not enough: deciding that a
+// loop is a bytecode interpreter needs the runtime value of the slot that holds
+// the program counter, so the frame comes along. Emits the three records
+// ruyitrace produces: vm_dispatch_detected, vm_branch_detected and vm_branch.
+void TraceOpcodeVm(JSContext* cx, JSScript* script, jsbytecode* pc,
+                   JS::Value* sp, InterpreterFrame* frame);
+
+// One runtime-compiled source string (eval / Function / Wasm). Called from
+// JSContext::isRuntimeCodeGenEnabled so every path is covered by one hook.
+// Writes to RUYIJS_DOM_EVAL_TRACE when that names a file.
+void TraceDynamicCode(JSContext* cx, JS::RuntimeCode kind,
+                      JS::Handle<JSString*> codeString,
+                      JS::CompilationType compilationType,
+                      JS::Handle<JSString*> bodyString);
+
+// One `typeof` evaluation, as ruyitrace's domtrace `type: "typeof"` record. The
+// operand is the value before the operator ran, so the record can be replayed
+// without the script. Written to the domtrace stream on JSOp::Typeof, which is
+// the only place both values exist at once.
+void TraceTypeof(JSContext* cx, JS::HandleValue operand, JS::HandleString result);
+
+// One `instanceof` evaluation, ruyitrace's `type: "instanceof"` record. `lhs` is
+// the tested value, `rhs` the constructor object, `result` the answer.
+void TraceInstanceof(JSContext* cx, JS::HandleValue lhs, JS::HandleObject rhs,
+                     bool result);
+
+// WindowProxy association moved to vm/RuyijsWindowProxy.h so the proxy fix
+// can be applied without this trace patch.
+
+// Heavy engine-level streams (opcode / jscall) are ~70x slower than the DOM
+// families: a full run cannot even reach the rch request. The heavy gate lets
+// a run start light and arm the heavy streams at a chosen moment, while the
+// JIT still compiles the Baseline trampolines in (that decision is fixed at
+// compile time by BaselineOpcodeEnabled()).
+//
+// Env contract:
+//   RUYIJS_TRACE_HEAVY=off        start disarmed (default: armed, old behaviour)
+//   RUYIJS_TRACE_HEAVY_DELAY_MS=N arm N ms after process start
+//   RUYIJS_TRACE_HEAVY_URL=<sub>  arm when an http_packet.index URL contains <sub>
+//   RUYIJS_TRACE_HEAVY_WINDOW_MS=N disarm N ms after arming (bounded window)
+bool HeavyTraceArmed();
+void SetHeavyTraceArmed(bool armed);
+
+// Pro standalone kernel trace (MOZ_JS_STANDALONE_* / --trace-*). Implemented
+// in vm/StandaloneTracePro.cpp; the DOM/ruyitrace hooks below call these only
+// when the pro surface is configured, so neither stream changes the other.
+bool ProEnabled();
+void ProEnterCall(JSContext* cx, const JS::CallArgs& args, bool constructing,
+                  const char* entryPath, CallState* state, const char* name,
+                  const char* url, uint32_t line, uint32_t column);
+void ProLeaveCall(JSContext* cx, const JS::CallArgs& args,
+                  const CallState& state);
+void ProReflectCall(const char* name, const char* url, uint32_t line);
+void ProDynamicCodeHook(JSContext* cx, JS::RuntimeCode kind,
+                        JS::CompilationType compilationType,
+                        JS::Handle<JSString*> codeString,
+                        JS::Handle<JSString*> bodyString);
+
+}  // namespace standalone_trace
+}  // namespace js
