+
+}  // namespace
+
+// Engine-builtin access records. ruyitrace emits these into its domtrace family,
+// so they go to RUYIJS_CF_TRACE (the same file the WebIDL funnels write) and carry
+// the same 15 fields. That keeps one diff surface instead of two.
+FILE* DomFamilyHandle();
+
+// True when an opcode-level trace was requested. Read from the environment on
+// every call because IsEnabled runs before TraceOpcode has initialised its own
+// state, and a static cache there would be wrong for the first call.
+bool BytecodeTraceEnabled() {
+  // The interp funnel calls this for every dispatched opcode. While the
+  // deferred heavy gate is closed, short-circuit before the getenv scans so
+  // the light phase keeps its normal speed.
+  if (!HeavyArmed()) return false;
+  static const char* const kNames[] = {"RUYIJS_DOM_JSCALL_OPCODE_URL",
+                                       "RUYIJS_DOM_OPCODE",
+                                       "RUYIJS_DOM_JSVMP_TRACE"};
+  for (const char* name : kNames) {
+    const char* value = std::getenv(name);
+    if (value && *value && std::strcmp(value, "0") != 0) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool IsEnabled(Category category) {
+  if (category != Category::Ruyijs) {
+    return false;
+  }
+  // The pro standalone kernel trace uses the same engine call funnel but its
+  // own output/category/limit state. It must activate the hooks by itself.
+  if (ProEnabled()) return true;
+  // Either output family turns the call hooks on: the jscall trace needs
+  // RUYIJS_DOM_TRACE and the engine-builtin domtrace records need RUYIJS_CF_TRACE.
+  // They share one hook site, so the cheaper of the two must not be able to switch
+  // the other off.
+  if (TraceHandle() != nullptr || DomFamilyHandle() != nullptr) {
+    return true;
+  }
+  // The opcode and VM layers also need the call stack: their records carry
+  // call_id and depth, and without the enter/leave hooks every record from a
+  // nested function would claim to belong to the root frame. Those two switches
+  // write elsewhere, so they have to be consulted here as well.
+  return BytecodeTraceEnabled();
+}
+
+void AppendValueSummary(JSContext* cx, std::string* out, const JS::Value& value,
+                        int depth) {
+  if (value.isUndefined()) {
+    out->append("\"undefined\"");
+    return;
+  }
+  if (value.isNull()) {
+    out->append("\"null\"");
+    return;
+  }
+  if (value.isBoolean()) {
+    out->append(value.toBoolean() ? "true" : "false");
+    return;
+  }
+  if (value.isInt32()) {
+    char buffer[24];
+    std::snprintf(buffer, sizeof(buffer), "%d", value.toInt32());
+    out->append(buffer);
+    return;
+  }
+  if (value.isDouble()) {
+    const double number = value.toDouble();
+    // JSON has no NaN/Infinity literals; emit them as strings so the record
+    // stays parseable while keeping the distinction visible.
+    if (std::isnan(number)) {
+      out->append("\"NaN\"");
+      return;
+    }
+    if (std::isinf(number)) {
+      out->append(number > 0 ? "\"Infinity\"" : "\"-Infinity\"");
+      return;
+    }
+    char buffer[40];
+    std::snprintf(buffer, sizeof(buffer), "%.17g", number);
+    out->append(buffer);
+    return;
+  }
+  if (value.isString()) {
+    JS::RootedValue rooted(cx, value);
+    JS::RootedString text(cx, rooted.toString());
+    if (!text) {
+      out->append("\"\"");
+      return;
+    }
+    JS::UniqueChars utf8 = JS_EncodeStringToUTF8(cx, text);
+    if (!utf8) {
+      out->append("\"\"");
+      return;
+    }
+    const size_t length = std::strlen(utf8.get());
+    AppendJsonString(out, utf8.get(), length > 200 ? 200 : length);
+    return;
+  }
+  if (value.isObject()) {
+    // Objects are summarised as `#[object Name]` so a DOM node, an array and a
+    // plain object stay distinguishable without touching user code.
+    JS::RootedValue rooted(cx, value);
+    JS::RootedObject object(cx, &rooted.toObject());
+    const char* className = object->getClass()->name;
+    out->append("\"#");
+    out->append(className ? className : "Object");
+    out->append("\"");
+    return;
+  }
+  AppendJsonString(out, ValueTypeName(value));
+}
+
+// Derives ruyitrace's callee identity triple from the object pointer: the id is
+// the low 48 bits in hex, which is stable for the lifetime of the object and
+// lets a trace group repeated calls to the same function.
+void DescribeCallee(JSContext* cx, JS::HandleObject callee, CallState* state) {
+  state->isJsFunction = callee->is<JSFunction>();
+  state->isProxy = callee->is<js::ProxyObject>();
+  state->isCallable = callee->isCallable();
+  state->calleeObjectClass =
+      callee->getClass()->name ? callee->getClass()->name : "Object";
+  state->calleeValueType = "object";
+
+  const uintptr_t bits = reinterpret_cast<uintptr_t>(callee.get()) & 0xFFFFFFFFFFFFull;
+  std::snprintf(state->calleeObjectId, sizeof(state->calleeObjectId), "%llx",
+                static_cast<unsigned long long>(bits));
+
+  if (state->isJsFunction) {
+    JS::RootedFunction function(cx, &callee->as<JSFunction>());
+    state->calleeKind = function->isNativeWithoutJitEntry()  ? "native"
+                        : function->isSelfHostedBuiltin()   ? "selfhosted"
+                                                            : "interpreted";
+    state->calleeIdentityKind = "jsfunction";
+    std::snprintf(state->calleeIdentity, sizeof(state->calleeIdentity), "jsfun:%s",
+                  state->calleeObjectId);
+  } else if (state->isProxy) {
+    state->calleeKind = "proxy";
+    state->calleeIdentityKind = "proxy";
+    std::snprintf(state->calleeIdentity, sizeof(state->calleeIdentity), "proxy:%s",
+                  state->calleeObjectId);
+  } else if (state->isCallable) {
+    state->calleeKind = "callable_object";
+    state->calleeIdentityKind = "callable";
+    std::snprintf(state->calleeIdentity, sizeof(state->calleeIdentity), "callable:%s",
+                  state->calleeObjectId);
+  } else {
+    state->calleeKind = "object";
+    state->calleeIdentityKind = "object";
+    std::snprintf(state->calleeIdentity, sizeof(state->calleeIdentity), "object:%s",
+                  state->calleeObjectId);
+  }
+}
+
+// ruyitrace's prototype_lookup carries a JS call stack as one object per frame.
+// The engine exposes it through SavedFrame accessors, so no custom frame walker
+// is needed.
+static void AppendJsFrameStack(JSContext* cx, std::string* out) {
+  JS::RootedObject stack(cx);
+  if (!JS::CaptureCurrentStack(cx, &stack,
+                               JS::StackCapture(JS::MaxFrames(16)))) {
+    JS_ClearPendingException(cx);
+    return;
+  }
+  bool first = true;
+  JS::RootedObject frame(cx, stack);
+  for (int i = 0; frame && i < 16; ++i) {
+    JS::RootedValue value(cx);
+    auto readString = [&](const char* key) -> std::string {
+      JS::RootedValue v(cx);
+      if (!JS_GetProperty(cx, frame, key, &v)) {
+        JS_ClearPendingException(cx);
+        return {};
+      }
+      if (!v.isString()) {
+        return {};
+      }
+      JS::RootedString text(cx, v.toString());
+      JS::UniqueChars utf8 = JS_EncodeStringToUTF8(cx, text);
+      if (!utf8) {
+        JS_ClearPendingException(cx);
+        return {};
+      }
+      return std::string(utf8.get());
+    };
+    auto readNumber = [&](const char* key) -> int64_t {
+      JS::RootedValue v(cx);
+      if (!JS_GetProperty(cx, frame, key, &v)) {
+        JS_ClearPendingException(cx);
+        return 0;
+      }
+      return v.isNumber() ? static_cast<int64_t>(v.toNumber()) : 0;
+    };
+    const std::string func = readString("functionDisplayName");
+    const std::string file = readString("source");
+    const int64_t line = readNumber("line");
+    const int64_t col = readNumber("column");
+    if (!first) {
+      out->push_back(',');
+    }
+    first = false;
+    out->append("{\"func\":");
+    AppendJsonString(out, func.c_str());
+    out->append(",\"file\":");
+    AppendJsonString(out, file.c_str());
+    out->append(",\"line\":");
+    AppendNumber(out, "%lld", static_cast<long long>(line));
+    out->append(",\"col\":");
+    AppendNumber(out, "%lld", static_cast<long long>(col));
+    out->push_back('}');
+    JS::RootedValue parent(cx);
+    if (!JS_GetProperty(cx, frame, "parent", &parent)) {
+      JS_ClearPendingException(cx);
+      break;
+    }
+    if (!parent.isObject()) {
+      break;
+    }
+    frame.set(&parent.toObject());
+    (void)value;
+  }
+}
+
+// ruyitrace writes object reprs as "[Object Xxx]" while JS::ToString gives
+// "[object Xxx]"; normalise the leading word without touching the rest.
+static std::string ObjectReprText(JSContext* cx, JS::HandleObject object) {
+  JS::RootedValue value(cx, JS::ObjectOrNullValue(object));
+  JS::RootedString repr(cx, JS::ToString(cx, value));
+  if (!repr) {
+    JS_ClearPendingException(cx);
+    return "[Object Object]";
+  }
+  JS::UniqueChars text = JS_EncodeStringToUTF8(cx, repr);
+  if (!text) {
+    JS_ClearPendingException(cx);
+    return "[Object Object]";
+  }
+  std::string result(text.get());
+  if (result.compare(0, 8, "[object ") == 0) {
+    result.replace(1, 6, "Object");
+  }
+  return result;
+}
+
+static void AppendObjectRepr(JSContext* cx, JS::HandleObject object,
+                             std::string* out) {
+  out->append("{\"repr\":");
+  AppendJsonString(out, ObjectReprText(cx, object).c_str());
+  out->append(",\"class\":");
+  const JSClass* clasp = object ? JS::GetClass(object) : nullptr;
+  AppendJsonString(out, clasp && clasp->name ? clasp->name : "Object");
+  out->push_back('}');
+}
+
+// Reflect.getPrototypeOf and Object.getPrototypeOf are their own family, because
+// the answer is an object rather than a descriptor or a key list.
+void EmitPrototypeLookup(JSContext* cx, JS::HandleObject target,
+                         const char* api) {
+  static FILE* file = []() -> FILE* {
+    const char* path = std::getenv("RUYIJS_DOM_DESCRIPTOR_TRACE");
+    return path && *path ? std::fopen(path, "ab") : nullptr;
+  }();
+  if (!file || !target) {
+    return;
+  }
+  static uint64_t seq = 0;
+  JS::RootedObject proto(cx);
+  const bool operationOk = JS_GetPrototype(cx, target, &proto);
+  if (!operationOk) {
+    JS_ClearPendingException(cx);
+  }
+  const bool found = operationOk && proto.get() != nullptr;
+
+  const std::string targetInput = ObjectReprText(cx, target);
+
+  std::string record;
+  record.reserve(640);
+  record.append("{\"seq\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(seq++));
+  record.append(",\"ts\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(RecordTs()));
+  record.append(",\"pid\":");
+  AppendNumber(&record, "%d", static_cast<long long>(CurrentPid()));
+  record.append(",\"origin_call_id\":0,\"type\":\"prototype_lookup\",\"api\":");
+  AppendJsonString(&record, api);
+  record.append(",\"target\":");
+  AppendObjectRepr(cx, target, &record);
+  record.append(",\"targetInput\":");
+  AppendJsonString(&record, targetInput.c_str());
+  record.append(",\"prototype\":");
+  AppendObjectRepr(cx, proto, &record);
+  record.append(",\"found\":");
+  record.append(found && proto ? "true" : "false");
+  record.append(",\"nullPrototype\":");
+  record.append(!proto ? "true" : "false");
+  record.append(",\"stack\":[");
+  AppendJsFrameStack(cx, &record);
+  record.append("]}\n");
+  Emit(file, record);
+}
+
+// ruyitrace exposes a descriptor family of its own, recording every reflective
+// lookup (getOwnPropertyDescriptor, ownKeys, getPrototypeOf). ruyijs reaches the
+// same information through the native-call funnel, so a record is derived here
+// for the reflective builtins and written to RUYIJS_DOM_DESCRIPTOR_TRACE.
+bool DescriptorFamily(const char* name) {
+  if (!name || !*name) {
+    return false;
+  }
+  return std::strcmp(name, "getOwnPropertyDescriptor") == 0 ||
+         std::strcmp(name, "getOwnPropertyDescriptors") == 0 ||
+         std::strcmp(name, "getOwnPropertyNames") == 0 ||
+         std::strcmp(name, "getOwnPropertySymbols") == 0 ||
+         std::strcmp(name, "keys") == 0 ||
+         std::strcmp(name, "getPrototypeOf") == 0 ||
+         std::strcmp(name, "hasOwnProperty") == 0;
+}
+
+void EmitDescriptor(JSContext* cx, JS::HandleObject callee, JS::HandleObject target,
+                    const char* api, const char* prop, bool found,
+                    const char* descriptorKind, bool hasValue, bool hasGet,
+                    bool hasSet, const char* valueType, bool writable,
+                    bool enumerable, bool configurable) {
+  static FILE* file = []() -> FILE* {
+    const char* path = std::getenv("RUYIJS_DOM_DESCRIPTOR_TRACE");
+    return path && *path ? std::fopen(path, "ab") : nullptr;
+  }();
+  if (!file) {
+    return;
+  }
+  static uint64_t seq = 0;
+  std::string record;
+  record.reserve(512);
+  char head[96];
+  std::snprintf(head, sizeof(head),
+                "{\"seq\":%llu,\"pid\":%lld,\"ts\":%lld,\"origin_call_id\":0,"
+                "\"type\":\"descriptor_lookup\",\"api\":",
+                static_cast<unsigned long long>(seq++), CurrentPid(),
+                static_cast<long long>(RecordTs()));
+  record.append(head);
+  AppendJsonString(&record, api ? api : "");
+  record.append(",\"target\":{\"repr\":{\"type\":");
+  AppendJsonString(&record, target ? (target->isCallable() ? "Function" : "Object") : "Object");
+  if (target) {
+    record.append(",\"name\":");
+    JS::UniqueChars targetName = CalleeName(cx, target);
+    AppendJsonString(&record, targetName ? targetName.get() : "");
+  } else {
+    record.append(",\"name\":\"\"");
+  }
+  record.append("},\"class\":");
+  AppendJsonString(&record, target && target->getClass()->name ? target->getClass()->name : "Object");
+  record.append("},\"targetInput\":{\"type\":");
+  AppendJsonString(&record, target ? (target->isCallable() ? "Function" : "Object") : "Object");
+  record.append("},\"prop\":");
+  AppendJsonString(&record, prop ? prop : "");
+  record.append(found ? ",\"found\":true" : ",\"found\":false");
+  record.append(",\"descriptorKind\":");
+  AppendJsonString(&record, descriptorKind ? descriptorKind : "");
+  record.append(hasValue ? ",\"hasValue\":true" : ",\"hasValue\":false");
+  record.append(hasGet ? ",\"hasGet\":true" : ",\"hasGet\":false");
+  record.append(hasSet ? ",\"hasSet\":true" : ",\"hasSet\":false");
+  record.append(",\"valueType\":");
+  AppendJsonString(&record, valueType ? valueType : "undefined");
+  record.append(",\"getterName\":null,\"setterName\":null");
+  record.append(writable ? ",\"writable\":true" : ",\"writable\":false");
+  record.append(enumerable ? ",\"enumerable\":true" : ",\"enumerable\":false");
+  record.append(configurable ? ",\"configurable\":true" : ",\"configurable\":false");
+  record.append(",\"hasSymbol\":false,\"keyCount\":0,\"keysSample\":[],\"truncated\":false");
+  record.append(",\"stack\":[]}\n");
+  Emit(file, record);
+}
+
+// ruyitrace records ownKeys separately from getOwnPropertyDescriptor, with the
+// returned key list sampled. ruyijs derives it from the same reflective funnel.
+void EmitOwnKeys(JSContext* cx, JS::HandleObject target, const char* api) {
+  static FILE* file = []() -> FILE* {
+    const char* path = std::getenv("RUYIJS_DOM_DESCRIPTOR_TRACE");
+    return path && *path ? std::fopen(path, "ab") : nullptr;
+  }();
+  if (!file) {
+    return;
+  }
+  static uint64_t seq = 0;
+  std::string record;
+  record.reserve(384);
+  char head[96];
+  std::snprintf(head, sizeof(head),
+                "{\"seq\":%llu,\"pid\":%lld,\"ts\":%lld,\"origin_call_id\":0,"
+                "\"type\":\"own_keys\",\"api\":",
+                static_cast<unsigned long long>(seq++), CurrentPid(),
+                static_cast<long long>(RecordTs()));
+  record.append(head);
+  AppendJsonString(&record, api ? api : "");
+  record.append(",\"target\":{\"repr\":");
+  AppendJsonString(&record, "[Object Object]");
+  record.append(",\"class\":");
+  AppendJsonString(&record, target && target->getClass()->name ? target->getClass()->name : "Object");
+  record.append("},\"targetInput\":");
+  AppendJsonString(&record, "[Object Object]");
+
+  // Sample up to 32 own keys so the record stays small while still showing what
+  // the page was looking at; ruyitrace caps its sample the same way.
+  JS::RootedIdVector ids(cx);
+  size_t keyCount = 0;
+  if (target && js::GetPropertyKeys(cx, target, JSITER_OWNONLY, &ids)) {
+    keyCount = ids.length();
+    record.append(",\"keyCount\":");
+    AppendNumber(&record, "%lld", static_cast<long long>(keyCount));
+    record.append(",\"keysSample\":[");
+    const size_t sample = keyCount < 32 ? keyCount : 32;
+    for (size_t i = 0; i < sample; ++i) {
+      if (i) {
+        record.push_back(',');
+      }
+      JS::RootedId id(cx, ids[i]);
+      JS::RootedValue key(cx);
+      if (JS_IdToValue(cx, id, &key)) {
+        AppendValueSummary(cx, &record, key, 0);
+      } else {
+        record.append("null");
+      }
+    }
+    record.push_back(']');
+    record.append(keyCount > sample ? ",\"truncated\":true" : ",\"truncated\":false");
+  } else {
+    record.append(",\"keyCount\":0,\"keysSample\":[],\"truncated\":false");
+  }
+  record.append(",\"hasSymbol\":false,\"stack\":[]}\n");
+  Emit(file, record);
+}
+
+// Engine-builtin access records. ruyitrace emits these into its domtrace family,
+// so they go to RUYIJS_CF_TRACE (the same file the WebIDL funnels write) and carry
+// the same 15 fields. That keeps one diff surface instead of two.
+FILE* DomFamilyHandle() {
+  static FILE* file = []() -> FILE* {
+    const char* path = std::getenv("RUYIJS_CF_TRACE");
+    return path && *path ? std::fopen(path, "ab") : nullptr;
+  }();
+  return file;
+}
+
+void EmitBuiltinAccess(JSContext* cx, const char* iface, const char* member,
+                       const char* kind, const char* valueText) {
+  FILE* file = DomFamilyHandle();
+  if (!file) {
+    return;
+  }
+  static uint64_t seq = 0;
+  std::string record;
+  record.reserve(320);
+  char head[160];
+  std::snprintf(head, sizeof(head),
+                "{\"seq\":%llu,\"pid\":%lld,\"ts\":%lld,\"type\":",
+                static_cast<unsigned long long>(seq++),
+                static_cast<long long>(CurrentPid()),
+                static_cast<long long>(RecordTs()));
+  record.append(head);
+  AppendJsonString(&record, kind ? kind : "call");
+  record.append(",\"interface\":");
+  AppendJsonString(&record, iface ? iface : "");
+  record.append(",\"member\":");
+  AppendJsonString(&record, member ? member : "");
+  record.append(",\"thisObj\":null,\"value\":");
+  record.append(valueText ? valueText : "null");
+  record.append(",\"valueObj\":null,\"return\":null,\"returnObj\":null");
+  // L2: engine-side builtin access records also carry explicit kinds.
+  const char* vtext = valueText ? valueText : "null";
+  const char* vkind = "js_null";
+  if (*vtext == '"') vkind = "string";
+  else if (*vtext == '{' || *vtext == '[') vkind = "object";
+  else if (std::strcmp(vtext, "true") == 0 ||
+           std::strcmp(vtext, "false") == 0) vkind = "boolean";
+  else if (std::strcmp(vtext, "null") != 0) vkind = "number";
+  record.append(",\"stack\":[],\"args\":[],\"args_kind\":\"json_array\","
+                "\"postArgs\":null,\"postArgs_kind\":\"js_null\","
+                "\"thisObj_kind\":\"js_null\",\"return_kind\":\"js_null\","
+                "\"value_kind\":\"");
+  record.append(vkind);
+  record.append("\",\"origin_call_id\":0}\n");
+  Emit(file, record);
+}
+
+/**
+ * Emits one operator-level record into the domtrace stream.
+ *
+ * ruyitrace reports `typeof` and `instanceof` alongside member accesses in the
+ * same stream, distinguished only by `type`. Both carry their operands so the
+ * record can be read without the script; the field sets differ, so the caller
+ * supplies the body.
+ */
+void EmitOperatorRecord(const char* type, const std::string& body) {
+  FILE* file = DomFamilyHandle();
+  if (!file) {
+    return;
+  }
+  static uint64_t seq = 0;
+  std::string record;
+  record.reserve(body.size() + 160);
+  char head[160];
+  std::snprintf(head, sizeof(head),
+                "{\"seq\":%llu,\"ts\":%lld,\"pid\":%lld,\"type\":",
+                static_cast<unsigned long long>(seq++),
+                static_cast<long long>(NowEpochMillis()),
+                static_cast<long long>(CurrentPid()));
+  record.append(head);
+  AppendJsonString(&record, type);
+  record.append(body);
+  record.append(",\"stack\":[]}\n");
+  Emit(file, record);
+}
+
+void TraceTypeof(JSContext* cx, JS::HandleValue operand, JS::HandleString result) {
+  if (!DomFamilyHandle()) {
+    return;
+  }
+  std::string body;
+  body.reserve(160);
+  body.append(",\"operand\":");
+  JS::RootedString operandText(cx, JS::ToString(cx, operand));
+  if (operandText) {
+    JS::UniqueChars utf8 = JS_EncodeStringToUTF8(cx, operandText);
+    if (utf8) {
+      AppendJsonString(&body, utf8.get());
+    } else {
+      JS_ClearPendingException(cx);
+      body.append("null");
+    }
+  } else {
+    JS_ClearPendingException(cx);
+    body.append("null");
+  }
+  body.append(",\"result\":");
+  JS::RootedString resultRoot(cx, result);
+  JS::UniqueChars resultText =
+      resultRoot ? JS_EncodeStringToUTF8(cx, resultRoot) : nullptr;
+  if (resultText) {
+    AppendJsonString(&body, resultText.get());
+  } else {
+    body.append("null");
+  }
+  EmitOperatorRecord("typeof", body);
+}
+
+void TraceInstanceof(JSContext* cx, JS::HandleValue lhs, JS::HandleObject rhs,
+                     bool result) {
+  if (!DomFamilyHandle()) {
+    return;
+  }
+  std::string body;
+  body.reserve(200);
+  body.append(",\"lhs\":");
+  {
+    JS::RootedString text(cx, JS::ToString(cx, lhs));
+    JS::UniqueChars utf8 = text ? JS_EncodeStringToUTF8(cx, text) : nullptr;
+    if (utf8) {
+      AppendJsonString(&body, utf8.get());
+    } else {
+      JS_ClearPendingException(cx);
+      body.append("null");
+    }
+  }
+  body.append(",\"rhs\":");
+  {
+    // The constructor name is what ruyitrace reports, not the object id.
+    JS::RootedValue name(cx);
+    JS::RootedObject holder(cx, rhs);
+    if (JS_GetProperty(cx, holder, "name", &name) && name.isString()) {
+      JS::RootedString nameText(cx, name.toString());
+      JS::UniqueChars utf8 = JS_EncodeStringToUTF8(cx, nameText);
+      if (utf8) {
+        AppendJsonString(&body, utf8.get());
+      } else {
+        body.append("null");
+      }
+    } else {
+      JS_ClearPendingException(cx);
+      body.append("null");
+    }
+  }
+  body.append(result ? ",\"result\":true" : ",\"result\":false");
+  EmitOperatorRecord("instanceof", body);
+}
+
+void EnterCall(JSContext* cx, const JS::CallArgs& args, bool constructing,
+               const char* entryPath, CallState* state) {
+  if (!state) return;
+  const bool heavy = HeavyArmed();
+  FILE* file = heavy ? TraceHandle() : nullptr;
+  const bool domFamily = DomFamilyHandle() != nullptr;
+  const bool bytecode = BytecodeTraceEnabled();
+  const bool proEnabled = ProEnabled();
+  const bool hasDomOutputs = file != nullptr || domFamily || bytecode;
+  if (!hasDomOutputs && !proEnabled) return;
+
+  // Resolve identity once for either trace family. Pro records use the same
+  // callee/name/position inputs but write through their own config/counters.
+  const size_t argc = args.length();
+  JS::RootedObject callee(cx, &args.callee());
+  JS::UniqueChars name = CalleeName(cx, callee);
+  DescribeCallee(cx, callee, state);
+  CallPositions positions;
+  ResolvePositions(cx, callee, &positions);
+
+  // Snapshot what the completed DOM record will need; see CallState for why.
+  state->constructing = constructing;
+  state->entryPath = entryPath ? entryPath : "";
+  state->argc = argc;
+  if (name) {
+    std::snprintf(state->calleeName, sizeof(state->calleeName), "%s", name.get());
+  }
+  if (positions.calleeUrl) {
+    std::snprintf(state->calleeUrl, sizeof(state->calleeUrl), "%s", positions.calleeUrl.get());
+  }
+  if (positions.callerUrl) {
+    std::snprintf(state->callerUrl, sizeof(state->callerUrl), "%s", positions.callerUrl.get());
+  }
+  state->calleeLine = static_cast<int32_t>(positions.calleeLine);
+  state->calleeColumn = static_cast<int32_t>(positions.calleeColumn);
+  state->callerLine = static_cast<int32_t>(positions.callerLine);
+  state->callerColumn = static_cast<int32_t>(positions.callerColumn);
+  if (ArgsEnabled()) {
+    state->argTypeCount = static_cast<int32_t>(argc < 16 ? argc : 16);
+    for (int32_t i = 0; i < state->argTypeCount; ++i) {
+      state->argTypes[i] = ValueTypeCode(args[i]);
+    }
+  }
+
+  // Pro standalone kernel trace: real interpreter/native calls. It has its own
+  // config, file, category mask, call tree, sequence and limit counters. Emit
+  // pro records before the DOM cap so a capped RUYIJS_DOM_TRACE cannot suppress
+  // them.
+  if (proEnabled) {
+    ProEnterCall(cx, args, constructing, entryPath, state,
+                 name ? name.get() : nullptr,
+                 positions.calleeUrl ? positions.calleeUrl.get() : nullptr,
+                 positions.calleeLine, positions.calleeColumn);
+    ProReflectCall(name ? name.get() : nullptr,
+                   positions.calleeUrl ? positions.calleeUrl.get() : nullptr,
+                   positions.calleeLine);
+  }
+
+  // Pro-only calls must not consume the DOM jscall sequence or advance the
+  // DOM cap. The DOM heavy stream is entirely independent of ProConfig.
+  if (!hasDomOutputs) return;
+
+  const uint64_t limit = DomJscallLimit();
+  uint64_t& domJscallCount = DomJscallSequence();
+  if (limit > 0 && domJscallCount >= limit) {
+    EmitLimitReached(file, "jscall", limit);
+    return;
+  }
+  ++domJscallCount;
+  // All DOM/ruyitrace records share one sequence; the jscall cap counts only
+  // emitted jscall frames. Pro JSONL has ProConfig::seq and is not mixed in.
+  const uint64_t seq = NextDomSeq();
+
+  Stack& stack = CallStack();
+  state->callId = seq + 1;
+  state->parentCallId = stack.current;
+  state->rawParentCallId = stack.current;
+  state->depth = stack.depth + 1;
+  state->parentStatus = stack.current ? "linked" : "root";
+  state->parentElideReason = "";
+  state->parentOmittedDepth = 0;
+  state->startMicros = NowMicros();
+  state->active = true;
+  stack.current = state->callId;
+  stack.depth = state->depth;
+
+
+  // Reflective lookups get their own record so a descriptor trace can be diffed
+  // without filtering the whole jscall stream.
+  if (name && DescriptorFamily(name.get())) {
+    JS::RootedObject target(cx);
+    const char* prop = "";
+    JS::UniqueChars propText;
+    if (argc >= 1 && args[0].isObject()) {
+      target.set(&args[0].toObject());
+    }
+    // ruyitrace reports the qualified API name (Object.getOwnPropertyDescriptor,
+    // Reflect.getPrototypeOf, Object.keys). BuiltinInterface resolves the holder
+    // from the callee; fall back to the bare name when no holder is found.
+    auto qualifiedApi = [&](const char* bare) -> std::string {
+      JS::UniqueChars iface = BuiltinInterface(cx, callee, bare);
+      std::string api;
+      if (iface && *iface.get()) {
+        api.assign(iface.get());
+        api.push_back('.');
+      } else {
+        // A reflected function kept in a page local can lose its holder link.
+        // The member name still identifies the builtin owner unambiguously.
+        static const struct { const char* member; const char* holder; } kDefaults[] = {
+            {"getOwnPropertyDescriptor", "Object"},
+            {"getOwnPropertyDescriptors", "Object"},
+            {"getOwnPropertyNames", "Object"},
+            {"getOwnPropertySymbols", "Object"},
+            {"getPrototypeOf", "Reflect"},
+            {"keys", "Object"},
+            {"ownKeys", "Reflect"},
+            {"hasOwnProperty", "Object"},
+        };
+        for (const auto& entry : kDefaults) {
+          if (std::strcmp(bare, entry.member) == 0) {
+            api.assign(entry.holder);
+            api.push_back('.');
+            break;
+          }
+        }
+      }
+      api.append(bare);
+      return api;
+    };
+    const std::string api = qualifiedApi(name.get());
+    const bool keysOnly = std::strcmp(name.get(), "getOwnPropertyNames") == 0 ||
+                          std::strcmp(name.get(), "getOwnPropertySymbols") == 0 ||
+                          std::strcmp(name.get(), "keys") == 0;
+    if (keysOnly) {
+      EmitOwnKeys(cx, target, api.c_str());
+    } else if (std::strcmp(name.get(), "getPrototypeOf") == 0) {
+      EmitPrototypeLookup(cx, target, api.c_str());
+    } else {
+      if (argc >= 2) {
+        if (args[1].isString()) {
+          JS::RootedValue key(cx, args[1]);
+          JS::RootedString text(cx, key.toString());
+          if (text) {
+            propText = JS_EncodeStringToUTF8(cx, text);
+            if (propText) {
+              prop = propText.get();
+            }
+          }
+        } else if (args[1].isInt32()) {
+          propText = DuplicateString(cx, std::to_string(args[1].toInt32()).c_str());
+          if (propText) {
+            prop = propText.get();
+          }
+        }
+      }
+      EmitDescriptor(cx, callee, target, api.c_str(), prop, true, "data", true, false,
+                     false, "object", false, false, false);
+    }
+  }
+
+  // Engine builtins: ruyitrace's hook is inside the JS engine, so it reports
+  // `Math.abs`, `Function.prototype.toString`, `JSON.parse` and the collection
+  // methods as domtrace accesses. ruyijs reaches the same surface from the callee.
+  if (DomFamilyHandle()) {
+    JS::UniqueChars iface = name ? BuiltinInterface(cx, callee, name.get()) : nullptr;
+    // `fn.call(recv)` / `fn.apply(recv)` forward to fn. ruyitrace's hook sits inside
+    // the callee, so it reports the forwarded function and never the forwarder.
+    // Resolving the first argument reproduces that: Map.prototype.has.call(m, k)
+    // is reported as Map.has, which is how the page actually reaches it.
+    if (iface && std::strcmp(iface.get(), "Function") == 0 && name &&
+        (std::strcmp(name.get(), "call") == 0 ||
+         std::strcmp(name.get(), "apply") == 0) &&
+        args.length() > 0 && args.get(0).isObject()) {
+      JS::RootedObject forwarded(cx, &args.get(0).toObject());
+      if (forwarded->is<JSFunction>()) {
+        JS::UniqueChars forwardedText = CalleeName(cx, forwarded);
+        JS::UniqueChars forwardedIface =
+            forwardedText ? BuiltinInterface(cx, forwarded, forwardedText.get()) : nullptr;
+        if (forwardedIface) {
+          EmitBuiltinAccess(cx, forwardedIface.get(), forwardedText.get(), "call", nullptr);
+          iface = nullptr;
+        }
+      }
+    }
+    JS::UniqueChars member = name ? JS::UniqueChars(nullptr) : JS::UniqueChars(nullptr);
+    if (iface) {
+      EmitBuiltinAccess(cx, iface.get(), name.get(),
+                        constructing ? "construct" : "call", nullptr);
+    } else if (!name && callee->is<JSFunction>() &&
+               callee->as<JSFunction>().isSelfHostedBuiltin()) {
+      // Self-hosted builtins carry no display id; the holder scan recovers the
+      // member name so `Function.prototype.toString` is still addressable.
+      static const char* const kScanHolders[] = {"Function", "Object", "Array", "String"};
+      JS::RootedObject global(cx, JS::CurrentGlobalOrNull(cx));
+      JS::RootedValue holderValue(cx);
+      for (const char* holder : kScanHolders) {
+        if (!global || !JS_GetProperty(cx, global, holder, &holderValue) ||
+            !holderValue.isObject()) {
+          JS_ClearPendingException(cx);
+          continue;
+        }
+        JS::RootedObject holderObject(cx, &holderValue.toObject());
+        JS::RootedValue protoValue(cx);
+        if (!JS_GetProperty(cx, holderObject, "prototype", &protoValue) ||
+            !protoValue.isObject()) {
+          JS_ClearPendingException(cx);
+          continue;
+        }
+        JS::RootedObject proto(cx, &protoValue.toObject());
+        member = BuiltinMemberFor(cx, callee, proto);
+        if (member) {
+          std::string qualified(holder);
+          qualified += ".prototype";
+          const bool keepQualified = qualified == "Object.prototype";
+          EmitBuiltinAccess(cx, keepQualified ? qualified.c_str() : holder,
+                            member.get(), constructing ? "construct" : "call", nullptr);
+          break;
+        }
+      }
+    }
+  }
+
+  std::string record;
+  record.reserve(320);
+  record.append("{\"seq\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(seq));
+  record.append(",\"pid\":");
+  AppendNumber(&record, "%d", static_cast<long long>(CurrentPid()));
+  record.append(",\"ts\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(RecordTs()));
+  record.append(",\"type\":\"jscall_frame\",\"phase\":\"enter\",\"op\":\"");
+  record.append(constructing ? "construct" : "call");
+  record.append("\",\"entry_path\":");
+  AppendJsonString(&record, entryPath ? entryPath : "");
+  record.append(",\"call_id\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(state->callId));
+  record.append(",\"parent_call_id\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(state->parentCallId));
+  record.append(",\"depth\":");
+  AppendNumber(&record, "%d", state->depth);
+  record.append(",\"callee_name\":");
+  AppendJsonString(&record, name ? name.get() : "");
+  record.append(",\"callee_url\":");
+  AppendJsonString(&record, positions.calleeUrl ? positions.calleeUrl.get() : "");
+  record.append(",\"callee_line\":");
+  AppendNumber(&record, "%d", static_cast<long long>(positions.calleeLine));
+  record.append(",\"callee_column\":");
+  AppendNumber(&record, "%d", static_cast<long long>(positions.calleeColumn));
+  record.append(",\"caller_url\":");
+  AppendJsonString(&record, positions.callerUrl ? positions.callerUrl.get() : "");
+  record.append(",\"caller_line\":");
+  AppendNumber(&record, "%d", static_cast<long long>(positions.callerLine));
+  record.append(",\"caller_column\":");
+  AppendNumber(&record, "%d", static_cast<long long>(positions.callerColumn));
+  // callee_kind and friends were resolved once at entry (DescribeCallee), so the
+  // exit record can repeat them without touching the object again.
+  record.append(",\"callee_kind\":");
+  AppendJsonString(&record, state->calleeKind);
+  record.append(",\"callee_identity_kind\":");
+  AppendJsonString(&record, state->calleeIdentityKind);
+  record.append(",\"callee_identity\":");
+  AppendJsonString(&record, state->calleeIdentity);
+  record.append(",\"callee_id\":");
+  AppendJsonString(&record, state->calleeObjectId);
+  record.append(",\"callee_object_id\":");
+  AppendJsonString(&record, state->calleeObjectId);
+  record.append(",\"callee_object_class\":");
+  AppendJsonString(&record, state->calleeObjectClass);
+  record.append(",\"callee_value_type\":");
+  AppendJsonString(&record, state->calleeValueType);
+  record.append(",\"callee_capture_status\":");
+  AppendJsonString(&record, state->isJsFunction ? "ok_jsfunction" : "ok_object");
+  record.append(",\"is_proxy\":");
+  record.append(state->isProxy ? "true" : "false");
+  record.append(",\"is_jsfunction\":");
+  record.append(state->isJsFunction ? "true" : "false");
+  record.append(",\"is_callable\":");
+  record.append(state->isCallable ? "true" : "false");
+  // Parent link bookkeeping. ruyijs never elides frames, so the raw id always
+  // equals the effective id and the omitted depth stays zero.
+  record.append(",\"parent_status\":");
+  AppendJsonString(&record, state->parentStatus);
+  record.append(",\"raw_parent_call_id\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(state->rawParentCallId));
+  record.append(",\"parent_elide_reason\":");
+  AppendJsonString(&record, state->parentElideReason);
+  record.append(",\"parent_omitted_depth\":");
+  AppendNumber(&record, "%d", state->parentOmittedDepth);
+  record.append(",\"schema_version\":2");
+  record.append(",\"argc\":");
+  AppendNumber(&record, "%d", static_cast<long long>(argc));
+
+  if (ArgsEnabled()) {
+    record.append(",\"arg_types\":[");
+    for (size_t i = 0; i < argc; ++i) {
+      if (i) {
+        record.push_back(',');
+      }
+      AppendJsonString(&record, ValueTypeName(args[i]));
+    }
+    record.push_back(']');
+  }
+  if (ValuesEnabled()) {
+    record.append(",\"arg_values\":[");
+    for (size_t i = 0; i < argc && i < 4; ++i) {
+      if (i) {
+        record.push_back(',');
+      }
+      AppendValueSummary(cx, &record, args[i], ValueDepth());
+    }
+    record.push_back(']');
+  }
+  record.append("}\n");
+  Emit(file, record);
+}
+// ruyitrace emits one jscall_summary record per callee, aggregating the completed
+// jscall records for that callee. The interval switch decides how often a summary
+// line is flushed; the counters below only ever hold data that a jscall record
+// already carries, so the two views cannot disagree about a call.
+struct CallSummary {
+  uint64_t calls = 0;
+  int64_t totalDuration = 0;
+  int64_t maxDuration = 0;
+  int32_t depthMin = 0;
+  int32_t depthMax = 0;
+  char calleeKind[32] = {};
+  char calleeName[128] = {};
+  char calleeUrl[512] = {};
+  char calleeIdentity[24] = {};
+  char calleeObjectClass[64] = {};
+  char calleeValueType[32] = {};
+  bool isCallable = false;
+  bool isProxy = false;
+  bool isJsFunction = false;
+  uint64_t parentRoot = 0;
+  uint64_t parentLinked = 0;
+  uint64_t parentElided = 0;
+  uint64_t parentUntracedJit = 0;
+  uint64_t parentDroppedLimit = 0;
+  uint64_t parentUnknown = 0;
+};
+
+std::unordered_map<std::string, CallSummary>& Summaries() {
+  static std::unordered_map<std::string, CallSummary> map;
+  return map;
+}
+
+uint64_t SummaryInterval() {
+  static const uint64_t interval = [] {
+    const char* text = std::getenv("RUYIJS_DOM_JSCALL_SUMMARY_INTERVAL");
+    if (!text || !*text) {
+      return uint64_t(256);
+    }
+    const uint64_t value = std::strtoull(text, nullptr, 10);
+    return value ? value : uint64_t(256);
+  }();
+  return interval;
+}
+
+// Only emitted when the interval switch is set: ruyitrace leaves summary output
+// off by default, and an unconditional line would be a record the other side
+// does not produce.
+bool SummaryEnabled() {
+  static const bool enabled = [] {
+    const char* text = std::getenv("RUYIJS_DOM_JSCALL_SUMMARY_INTERVAL");
+    return text && *text;
+  }();
+  return enabled;
+}
+
+void AccumulateSummary(const CallState& state, int64_t duration) {
+  if (!SummaryEnabled()) {
+    return;
+  }
+  // Key on the callee identity so one function aggregates across call sites.
+  // calleeIdentity already carries its own prefix, so it is used verbatim.
+  std::string key;
+  if (state.calleeIdentity[0]) {
+    key.assign(state.calleeIdentity);
+  } else if (state.calleeObjectId[0]) {
+    key.assign("jsobj:");
+    key.append(state.calleeObjectId);
+  } else {
+    key.assign("anon:");
+    key.append(state.calleeName);
+  }
+
+  CallSummary& entry = Summaries()[key];
+  if (entry.calls == 0) {
+    entry.depthMin = state.depth;
+    entry.depthMax = state.depth;
+    std::snprintf(entry.calleeKind, sizeof(entry.calleeKind), "%s",
+                  state.calleeKind ? state.calleeKind : "");
+    std::snprintf(entry.calleeName, sizeof(entry.calleeName), "%s",
+                  state.calleeName);
+    std::snprintf(entry.calleeUrl, sizeof(entry.calleeUrl), "%s",
+                  state.calleeUrl);
+    std::snprintf(entry.calleeIdentity, sizeof(entry.calleeIdentity), "%s",
+                  state.calleeIdentity);
+    std::snprintf(entry.calleeObjectClass, sizeof(entry.calleeObjectClass), "%s",
+                  state.calleeObjectClass ? state.calleeObjectClass : "");
+    std::snprintf(entry.calleeValueType, sizeof(entry.calleeValueType), "%s",
+                  state.calleeValueType ? state.calleeValueType : "");
+    entry.isCallable = state.isCallable;
+    entry.isProxy = state.isProxy;
+    entry.isJsFunction = state.isJsFunction;
+  }
+  ++entry.calls;
+  entry.totalDuration += duration;
+  if (duration > entry.maxDuration) {
+    entry.maxDuration = duration;
+  }
+  if (state.depth < entry.depthMin) {
+    entry.depthMin = state.depth;
+  }
+  if (state.depth > entry.depthMax) {
+    entry.depthMax = state.depth;
+  }
+
+  // The parent counters describe how well the parent link was resolved; the
+  // status string is the only place that information exists.
+  const char* status = state.parentStatus ? state.parentStatus : "root";
+  if (!std::strcmp(status, "root")) {
+    ++entry.parentRoot;
+  } else if (!std::strcmp(status, "linked")) {
+    ++entry.parentLinked;
+  } else if (!std::strcmp(status, "elided")) {
+    ++entry.parentElided;
+  } else if (!std::strcmp(status, "untraced_jit")) {
+    ++entry.parentUntracedJit;
+  } else if (!std::strcmp(status, "dropped_limit")) {
+    ++entry.parentDroppedLimit;
+  } else {
+    ++entry.parentUnknown;
+  }
+}
+
+void FlushSummaries(FILE* file) {
+  if (!SummaryEnabled() || !file) {
+    return;
+  }
+  static uint64_t emitted = 0;
+  for (auto& pair : Summaries()) {
+    const std::string& key = pair.first;
+    const CallSummary& entry = pair.second;
+    std::string record;
+    record.reserve(640);
+    record.append("{\"seq\":");
+    AppendNumber(&record, "%lld", static_cast<long long>(emitted++));
+    record.append(",\"ts\":");
+    AppendNumber(&record, "%lld", static_cast<long long>(RecordTs()));
+    record.append(",\"pid\":");
+    AppendNumber(&record, "%d", static_cast<int>(CurrentPid()));
+    record.append(",\"type\":\"jscall_summary\",\"schema_version\":2");
+    record.append(",\"summary_key_kind\":");
+    AppendJsonString(&record, key.compare(0, 6, "jsfun:") == 0 ? "jsfunction"
+                             : key.compare(0, 6, "jsobj:") == 0 ? "jsobject"
+                                                                : "name");
+    record.append(",\"summary_key\":");
+    AppendJsonString(&record, key.c_str());
+    record.append(",\"callee_group\":");
+    AppendJsonString(&record, entry.calleeKind);
+    record.append(",\"callee_capture_status\":");
+    AppendJsonString(&record, entry.isJsFunction ? "ok_jsfunction" : "ok_object");
+    record.append(",\"callee_value_type\":");
+    AppendJsonString(&record, entry.calleeValueType);
+    record.append(",\"callee_object_class\":");
+    AppendJsonString(&record, entry.calleeObjectClass);
+    record.append(",\"is_callable\":");
+    record.append(entry.isCallable ? "true" : "false");
+    record.append(",\"is_proxy\":");
+    record.append(entry.isProxy ? "true" : "false");
+    record.append(",\"is_jsfunction\":");
+    record.append(entry.isJsFunction ? "true" : "false");
+    record.append(",\"callee_name\":");
+    AppendJsonString(&record, entry.calleeName);
+    record.append(",\"callee_kind\":");
+    AppendJsonString(&record, entry.calleeKind);
+    record.append(",\"callee_url\":");
+    AppendJsonString(&record, entry.calleeUrl);
+    record.append(",\"call_count\":");
+    AppendNumber(&record, "%lld", static_cast<long long>(entry.calls));
+    record.append(",\"total_duration_us\":");
+    AppendNumber(&record, "%lld", static_cast<long long>(entry.totalDuration));
+    record.append(",\"max_duration_us\":");
+    AppendNumber(&record, "%lld", static_cast<long long>(entry.maxDuration));
+    record.append(",\"depth_min\":");
+    AppendNumber(&record, "%d", entry.depthMin);
+    record.append(",\"depth_max\":");
+    AppendNumber(&record, "%d", entry.depthMax);
+    record.append(",\"parent_root_count\":");
+    AppendNumber(&record, "%lld", static_cast<long long>(entry.parentRoot));
+    record.append(",\"parent_linked_count\":");
+    AppendNumber(&record, "%lld", static_cast<long long>(entry.parentLinked));
+    record.append(",\"parent_elided_count\":");
+    AppendNumber(&record, "%lld", static_cast<long long>(entry.parentElided));
+    record.append(",\"parent_untraced_jit_count\":");
+    AppendNumber(&record, "%lld", static_cast<long long>(entry.parentUntracedJit));
+    record.append(",\"parent_dropped_limit_count\":");
+    AppendNumber(&record, "%lld", static_cast<long long>(entry.parentDroppedLimit));
+    record.append(",\"parent_unknown_count\":");
+    AppendNumber(&record, "%lld", static_cast<long long>(entry.parentUnknown));
+    record.append("}\n");
+    Emit(file, record);
+  }
+}
+
+void LeaveCall(JSContext* cx, const JS::CallArgs& args, const CallState& state,
+               bool ok) {
+  // Pro standalone kernel trace emits its own leave record from the live args,
+  // before the deferred heavy gate and the DOM/ruyitrace stream checks.
+  ProLeaveCall(cx, args, state);
+  if (!HeavyArmed()) return;  // deferred full trace: skip jscall until armed
+  FILE* file = TraceHandle();
+  if ((!file && !BytecodeTraceEnabled()) || !state.active) {
+    return;
+  }
+  Stack& stack = CallStack();
+  if (stack.current == state.callId) {
+    stack.current = state.parentCallId;
+    stack.depth = state.depth - 1;
+  }
+
+  const int64_t now = NowMicros();
+  const int64_t duration = now - state.startMicros;
+
+  // ruyitrace folds the outcome into the same jscall record: `ok`, `duration_us`
+  // and `result_type` live next to the callee identity. Emitting the completed
+  // record at exit keeps the field set identical while still describing a whole
+  // call. The enter-side jscall_frame carries everything except the outcome.
+  std::string record;
+  record.reserve(520);
+  record.append("{\"seq\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(state.callId - 1));
+  record.append(",\"pid\":");
+  AppendNumber(&record, "%d", static_cast<long long>(CurrentPid()));
+  record.append(",\"ts\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(RecordTs()));
+  record.append(",\"type\":\"jscall\",\"schema_version\":2");
+  record.append(",\"op\":");
+  AppendJsonString(&record, state.constructing ? "construct" : "call");
+  record.append(",\"entry_path\":");
+  AppendJsonString(&record, state.entryPath);
+  record.append(",\"callee_name\":");
+  AppendJsonString(&record, state.calleeName);
+  record.append(",\"callee_url\":");
+  AppendJsonString(&record, state.calleeUrl);
+  record.append(",\"callee_line\":");
+  AppendNumber(&record, "%d", state.calleeLine);
+  record.append(",\"callee_column\":");
+  AppendNumber(&record, "%d", state.calleeColumn);
+  record.append(",\"caller_url\":");
+  AppendJsonString(&record, state.callerUrl);
+  record.append(",\"caller_line\":");
+  AppendNumber(&record, "%d", state.callerLine);
+  record.append(",\"caller_column\":");
+  AppendNumber(&record, "%d", state.callerColumn);
+  record.append(",\"argc\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(state.argc));
+  if (ArgsEnabled()) {
+    record.append(",\"arg_types\":[");
+    for (int32_t i = 0; i < state.argTypeCount; ++i) {
+      if (i) {
+        record.push_back(',');
+      }
+      AppendJsonString(&record, TypeNameFromCode(state.argTypes[i]));
+    }
+    record.push_back(']');
+  }
+  record.append(",\"call_id\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(state.callId));
+  record.append(",\"parent_call_id\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(state.parentCallId));
+  record.append(",\"raw_parent_call_id\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(state.rawParentCallId));
+  record.append(",\"parent_status\":");
+  AppendJsonString(&record, state.parentStatus);
+  record.append(",\"parent_elide_reason\":");
+  AppendJsonString(&record, state.parentElideReason);
+  record.append(",\"parent_omitted_depth\":");
+  AppendNumber(&record, "%d", state.parentOmittedDepth);
+  record.append(",\"depth\":");
+  AppendNumber(&record, "%d", state.depth);
+  // Repeating the identity keeps a completed jscall self-contained, so a trace
+  // can be filtered on callee_kind without joining against the enter record.
+  record.append(",\"callee_identity\":");
+  AppendJsonString(&record, state.calleeIdentity);
+  record.append(",\"callee_id\":");
+  AppendJsonString(&record, state.calleeObjectId);
+  record.append(",\"callee_object_id\":");
+  AppendJsonString(&record, state.calleeObjectId);
+  record.append(",\"callee_identity_kind\":");
+  AppendJsonString(&record, state.calleeIdentityKind);
+  record.append(",\"callee_kind\":");
+  AppendJsonString(&record, state.calleeKind);
+  record.append(",\"callee_object_class\":");
+  AppendJsonString(&record, state.calleeObjectClass);
+  record.append(",\"callee_value_type\":");
+  AppendJsonString(&record, state.calleeValueType);
+  record.append(",\"callee_capture_status\":");
+  AppendJsonString(&record, state.isJsFunction ? "ok_jsfunction" : "ok_object");
+  record.append(",\"is_proxy\":");
+  record.append(state.isProxy ? "true" : "false");
+  record.append(",\"is_jsfunction\":");
+  record.append(state.isJsFunction ? "true" : "false");
+  record.append(",\"is_callable\":");
+  record.append(state.isCallable ? "true" : "false");
+  record.append(ok ? ",\"ok\":true" : ",\"ok\":false");
+  record.append(",\"duration_us\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(duration));
+  if (ArgsEnabled()) {
+    record.append(",\"result_type\":");
+    AppendJsonString(&record, ValueTypeName(args.rval()));
+  }
+  record.append("}\n");
+  Emit(file, record);
+
+  AccumulateSummary(state, duration);
+  // ruyitrace writes its summary once, from a process-wide snapshot taken at exit:
+  // one measured run produced 1 summary line against 511 jscall records. Flushing
+  // per interval instead produced 1212 lines for 514 calls, so the registration is
+  // done once and the snapshot is written when the process ends.
+  static const bool registered = [] {
+    if (!SummaryEnabled()) {
+      return true;
+    }
+    std::atexit([] {
+      FlushSummaries(TraceHandle());
+    });
+    return true;
+  }();
+  (void)registered;
+}
+
+// Decodes one immediate of `op` into `*out`, using the bytecode format table in
+// Opcodes.h. Appends nothing when ruyitrace reports no operand for this kind,
+// so the caller writes null and both sides agree on which opcodes carry one.
+//
+// The key names are ruyitrace's, not the JOF names: that trace is the contract,
+// and a different spelling makes the operands unreadable to anything consuming
+// both sides. Measured on facelessJsvmp's output, it emits jump_off / local /
+// arg / argc / int8 / uint8 / uint16 / uint24 / atom, and reports null for the
+// table indices and doubles that this engine also has.
+void AppendOperandJson(JSContext* cx, JSScript* script, jsbytecode* pc, JSOp op,
+                       std::string* out) {
+  const unsigned format = JOF_OPTYPE(op);
+  const unsigned type = format & JOF_TYPEMASK;
+  // Every GET_* helper in BytecodeUtil.h applies `pc + 1` itself, so these take
+  // the instruction pointer, not the immediate. Passing pc+1 shifted every
+  // operand by one byte and produced garbage (Call argc 41984 instead of 0).
+  jsbytecode* imm = pc;
+  switch (type) {
+    case JOF_BYTE:
+      return;  // no immediate
+    case JOF_INT8:
+      out->append("{\"int8\":");
+      AppendNumber(out, "%d", int(GET_INT8(imm)));
+      out->append("}");
+      return;
+    case JOF_UINT8:
+      out->append("{\"uint8\":");
+      AppendNumber(out, "%d", int(GET_UINT8(imm)));
+      out->append("}");
+      return;
+    case JOF_UINT16:
+      out->append("{\"uint16\":");
+      AppendNumber(out, "%d", int(GET_UINT16(imm)));
+      out->append("}");
+      return;
+    case JOF_ARGC:
+      out->append("{\"argc\":");
+      AppendNumber(out, "%d", int(GET_UINT16(imm)));
+      out->append("}");
+      return;
+    case JOF_UINT24:
+      out->append("{\"uint24\":");
+      AppendNumber(out, "%d", int(GET_UINT24(imm)));
+      out->append("}");
+      return;
+    case JOF_JUMP:
+      // Jump offsets are byte distances from this instruction.
+      out->append("{\"jump_off\":");
+      AppendNumber(out, "%d", int(GET_JUMP_OFFSET(imm)));
+      out->append("}");
+      return;
+    case JOF_QARG:
+      out->append("{\"arg\":");
+      AppendNumber(out, "%d", int(GET_ARGNO(imm)));
+      out->append("}");
+      return;
+    case JOF_LOCAL:
+      // The VM recognizer reads this to locate the pc register: its own pc lives
+      // in a local slot, so the slot number is the identifying operand.
+      out->append("{\"local\":");
+      AppendNumber(out, "%d", int(GET_LOCALNO(imm)));
+      out->append("}");
+      return;
+    case JOF_ATOM: {
+      // Atom immediates carry the property or global name, which is the operand
+      // the VM recognizer needs most: the dispatch loop's opcode table lookup
+      // shows up as a named global read.
+      JSAtom* atom = script->getAtom(imm);
+      if (!atom) {
+        return;
+      }
+      JS::RootedString text(cx, atom);
+      JS::UniqueChars utf8 = JS_EncodeStringToUTF8(cx, text);
+      out->append("{\"atom\":");
+      if (utf8) {
+        AppendJsonString(out, utf8.get());
+      } else {
+        JS_ClearPendingException(cx);
+        out->append("null");
+      }
+      out->append("}");
+      return;
+    }
+    // ruyitrace reports no operand for these even though the bytecode carries
+    // one: table indices (gc things, shapes, scopes), doubles, IC and resume
+    // indices. Leaving them out keeps the coverage ratio comparable.
+    default:
+      return;
+  }
+}
+
+namespace {
+
+// Shared body of the opcode record. |tier| is "interp" or "jit": ruyitrace
+// reports both and a consumer has to be able to tell them apart, because only
+// the interpreter tier carries stack values.
+// One stack slot, serialized the way ruyitrace serializes it: primitives as
+// themselves, objects as a short summary. ruyitrace only fills these in for the
+// interpreter tier, because the JIT tier has no stack buffer to read.
+void AppendStackSlot(JSContext* cx, JS::HandleValue value, std::string* out);
+
+void AppendStackSlotObject(JSContext* cx, JS::HandleObject object,
+                           std::string* out) {
+  // Arrays get their elements, everything else gets its own enumerable keys.
+  // Both are capped so a wide object cannot dominate the log.
+  const size_t kMaxItems = 20;
+  JS::RootedValueArray<1> ignored(cx);
+  (void)ignored;
+
+  bool isArray = false;
+  if (!JS::IsArrayObject(cx, object, &isArray)) {
+    JS_ClearPendingException(cx);
+    isArray = false;
+  }
+
+  if (isArray) {
+    uint32_t length = 0;
+    if (!JS::GetArrayLength(cx, object, &length)) {
+      JS_ClearPendingException(cx);
+      length = 0;
+    }
+    out->append("{\"type\":\"Array\",\"length\":");
+    AppendNumber(out, "%u", length);
+    out->append(length > kMaxItems ? ",\"truncated\":true" : ",\"truncated\":false");
+    out->append(",\"items\":[");
+    const uint32_t count = length < kMaxItems ? length : kMaxItems;
+    for (uint32_t i = 0; i < count; ++i) {
+      if (i) {
+        out->push_back(',');
+      }
+      JS::RootedValue element(cx);
+      if (!JS_GetElement(cx, object, i, &element)) {
+        JS_ClearPendingException(cx);
+        out->append("null");
+        continue;
+      }
+      AppendStackSlot(cx, element, out);
+    }
+    out->append("]}");
+    return;
+  }
+
+  // DOM and other exotic objects can expose thousands of names; enumerating them
+  // every op stalls the run (measured as a pipe timeout). They are reported as a
+  // tag instead, which is what ruyitrace shows for them too.
+  if (JS::IsCallable(object)) {
+    out->append("\"[object]\"");
+    return;
+  }
+  {
+    const JSClass* clasp = JS::GetClass(object);
+    if (!clasp || (clasp->flags & JSCLASS_IS_DOMJSCLASS)) {
+      out->append("\"[object]\"");
+      return;
+    }
+  }
+
+  JS::RootedIdVector keys(cx);
+  if (!js::GetPropertyKeys(cx, object, JSITER_OWNONLY, &keys)) {
+    JS_ClearPendingException(cx);
+    out->append("\"[object]\"");
+    return;
+  }
+
+  out->push_back('{');
+  if (keys.length() > kMaxItems) {
+    out->append("\"__truncated__\":{\"count\":");
+    AppendNumber(out, "%u", static_cast<unsigned>(keys.length()));
+    out->append(",\"shown\":");
+    AppendNumber(out, "%u", static_cast<unsigned>(kMaxItems));
+    out->append("}");
+    if (kMaxItems) {
+      out->push_back(',');
+    }
+  }
+  const size_t count = keys.length() < kMaxItems ? keys.length() : kMaxItems;
+  for (size_t i = 0; i < count; ++i) {
+    if (i) {
+      out->push_back(',');
+    }
+    JS::RootedId id(cx, keys[i]);
+    JS::RootedValue keyValue(cx);
+    if (!JS_IdToValue(cx, id, &keyValue)) {
+      JS_ClearPendingException(cx);
+      continue;
+    }
+    JS::RootedString keyString(cx, JS::ToString(cx, keyValue));
+    if (!keyString) {
+      JS_ClearPendingException(cx);
+      continue;
+    }
+    JS::RootedValue keyText(cx, JS::StringValue(keyString));
+    AppendStackSlot(cx, keyText, out);
+    out->push_back(':');
+    JS::RootedValue slot(cx);
+    if (!JS_GetPropertyById(cx, object, id, &slot)) {
+      JS_ClearPendingException(cx);
+      out->append("null");
+      continue;
+    }
+    AppendStackSlot(cx, slot, out);
+  }
+  out->push_back('}');
+}
+
+void AppendStackSlot(JSContext* cx, JS::HandleValue value, std::string* out) {
+  if (value.isUndefined()) {
+    out->append("\"undefined\"");
+    return;
+  }
+  if (value.isNull()) {
+    out->append("null");
+    return;
+  }
+  if (value.isBoolean()) {
+    out->append(value.toBoolean() ? "true" : "false");
+    return;
+  }
+  if (value.isInt32()) {
+    AppendNumber(out, "%d", value.toInt32());
+    return;
+  }
+  if (value.isNumber()) {
+    const double number = value.toNumber();
+    // JSON has no representation for the non-finite values, and ruyitrace writes
+    // them as strings so the record stays parseable.
+    if (std::isnan(number)) {
+      out->append("\"NaN\"");
+      return;
+    }
+    if (std::isinf(number)) {
+      out->append(number > 0 ? "\"Infinity\"" : "\"-Infinity\"");
+      return;
+    }
+    if (number == double(int64_t(number)) &&
+        number >= -9007199254740992.0 && number <= 9007199254740992.0) {
+      AppendNumber(out, "%lld", static_cast<long long>(number));
+    } else {
+      char buffer[40];
+      std::snprintf(buffer, sizeof(buffer), "%.17g", number);
+      out->append(buffer);
+    }
+    return;
+  }
+  if (value.isString()) {
+    JS::RootedString text(cx, value.toString());
+    if (!text) {
+      out->append("\"\"");
+      return;
+    }
+    JS::UniqueChars utf8 = JS_EncodeStringToUTF8(cx, text);
+    if (!utf8) {
+      JS_ClearPendingException(cx);
+      out->append("\"\"");
+      return;
+    }
+    AppendJsonString(out, utf8.get());
+    return;
+  }
+  if (value.isObject()) {
+    JS::RootedObject object(cx, &value.toObject());
+    if (!object) {
+      out->append("\"[object]\"");
+      return;
+    }
+    // Functions collapse to their tag: listing their properties is noise.
+    if (JS::IsCallable(object)) {
+      out->append("\"[object]\"");
+      return;
+    }
+    AppendStackSlotObject(cx, object, out);
+    return;
+  }
+  out->append("\"[object]\"");
+}
+
+void EmitOpcodeRecord(JSContext* cx, JSScript* script, jsbytecode* pc,
+                      JS::Value* sp, uint32_t stackDepth,
+                      InterpreterFrame* frame, const char* tier,
+                      uint32_t baselineDepth) {
+  if (!HeavyArmed()) return;  // deferred full trace: skip opcode until armed
+  static FILE* file = nullptr;
+  static bool initialized = false;
+  static uint64_t emitted = 0;
+  static uint64_t limit = 0;
+  static bool wantOperands = false;
+  static bool wantStack = false;
+  static bool wantStackFull = false;
+  static uint32_t stackSlots = 3;
+  static bool enabled = false;
+  if (!initialized) {
+    initialized = true;
+    // ruyitrace's opcode switches are named MOZ_DOM_JSCALL_OPCODE_URL (the
+    // enable switch) and _OPERANDS (immediate decoding). RUYIJS_DOM_OPCODE is
+    // still honoured as the older name so existing runs keep working.
+    const char* path = std::getenv("RUYIJS_DOM_JSCALL_OPCODE_URL");
+    if (!path || !*path) {
+      path = std::getenv("RUYIJS_DOM_OPCODE");
+    }
+    enabled = path && *path;
+    if (enabled) {
+      file = std::fopen(path, "ab");
+    }
+    const char* operandsEnv = std::getenv("RUYIJS_DOM_JSCALL_OPCODE_OPERANDS");
+    wantOperands = operandsEnv && *operandsEnv && std::strcmp(operandsEnv, "0") != 0;
+    const char* stackEnv = std::getenv("RUYIJS_DOM_JSCALL_OPCODE_STACK");
+    wantStack = stackEnv && *stackEnv && std::strcmp(stackEnv, "0") != 0;
+    const char* slotsEnv = std::getenv("RUYIJS_DOM_JSCALL_OPCODE_STACK_SLOTS");
+    stackSlots = slotsEnv && *slotsEnv
+                     ? static_cast<uint32_t>(std::strtoul(slotsEnv, nullptr, 10))
+                     : 3;
+    if (stackSlots == 0) {
+      stackSlots = 3;
+    }
+    const char* fullEnv = std::getenv("RUYIJS_DOM_JSCALL_OPCODE_STACK_FULL");
+    wantStackFull = fullEnv && *fullEnv && std::strcmp(fullEnv, "0") != 0;
+    const char* text = std::getenv("RUYIJS_DOM_OPCODE_LIMIT");
+    limit = text && *text ? static_cast<uint64_t>(std::strtoull(text, nullptr, 10)) : 0;
+  }  if (!enabled || !file || !script || !pc) {
+    return;
+  }
+  if (limit > 0 && emitted >= limit) {
+    EmitLimitReached(file, "opcode", limit);
+    return;
+  }
+  ++emitted;
+
+  const JSOp op = JSOp(*pc);
+  const char* name = CodeName(op);
+
+  std::string record;
+  record.reserve(160);
+  record.append("{\"seq\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(emitted - 1));
+  record.append(",\"pid\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(CurrentPid()));
+  record.append(",\"ts\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(RecordTs()));
+  record.append(",\"type\":\"opcode\",\"tier\":");
+  AppendJsonString(&record, tier);
+  record.append(",\"pc\":");
+  AppendNumber(&record, "%d", static_cast<long long>(pc - script->code()));
+  record.append(",\"op\":");
+  AppendJsonString(&record, name);
+  // The call id and depth come from the interpreter frame chain rather than the
+  // EnterCall/LeaveCall stack: an interpreted callee is entered by pushing an
+  // inline frame inside the same dispatch loop, so the jscall hooks never see
+  // it. Walking prev() describes the frame that is actually executing, which is
+  // what a reader of the record needs.
+  uint32_t frameDepth = baselineDepth;
+  uintptr_t frameId = 0;
+  if (frame) {
+    frameId = reinterpret_cast<uintptr_t>(frame);
+    if (baselineDepth == 0) {
+      for (InterpreterFrame* f = frame->prev(); f; f = f->prev()) {
+        ++frameDepth;
+      }
+    }
+  }
+  record.append(",\"call_id\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(frameId & 0x7fffffff));
+  record.append(",\"depth\":");
+  AppendNumber(&record, "%d", static_cast<long long>(frameDepth));
+  record.append(",\"url\":");
+  const char* filename = script->filename();
+  AppendJsonString(&record, filename ? filename : "");
+  record.append(",\"line\":");
+  AppendNumber(&record, "%d", static_cast<long long>(script->lineno()));
+  // Operand immediates are what the VM recognizer reads; without them the
+  // dispatch loop is indistinguishable from ordinary script code.
+  if (wantOperands) {
+    record.append(",\"operands\":");
+    std::string operands;
+    AppendOperandJson(cx, script, pc, op, &operands);
+    if (operands.empty()) {
+      record.append("null");
+    } else {
+      record.append(operands);
+    }
+  }
+  // The stack snapshot is interpreter-only, matching ruyitrace: the JIT tier has
+  // no bytecode stack to read, so those records carry no stack fields at all.
+  if (wantStack && sp) {
+    // The depth is passed by the caller: InterpreterFrame::slots() is private and
+    // only InterpreterRegs (which is a friend) can measure it.
+    uint32_t available = stackDepth;
+    record.append(",\"stack_depth\":");
+    AppendNumber(&record, "%u", available);
+    record.append(",\"stack\":[");
+    const uint32_t limit = wantStackFull ? 32u : stackSlots;
+    uint32_t taken = available < limit ? available : limit;
+    for (uint32_t i = 0; i < taken; ++i) {
+      if (i) {
+        record.push_back(',');
+      }
+      JS::RootedValue slot(cx, sp[-1 - static_cast<int32_t>(i)]);
+      AppendStackSlot(cx, slot, &record);
+    }
+    record.push_back(']');
+  }
+  record.append("}\n");
+  Emit(file, record);
+}
+
+}  // namespace
+
+namespace {
+
+// One candidate dispatch site, keyed by script + pc.
+//
+// A JSVMP interpreter reads its next opcode with an indexed load whose index
+// lives in a local slot that also takes part in an increment, so the recognizer
+// watches for that shape and then measures how the slot behaves: a real pc
+// advances (monotonic) across iterations, while an ordinary loop counter does
+// not index a byte array that way.
+struct DispatchSite {
+  int32_t pc = -1;
+  int32_t slot = -1;
+  uint32_t hits = 0;
+  uint32_t advances = 0;
+  double last = 0;
+  bool haveLast = false;
+  bool detected = false;
+};
+
+struct BranchSite {
+  int32_t pc = -1;
+  uint32_t hits = 0;
+  bool detected = false;
+};
+
+// Per-script recognition state. Bounded so a long run cannot grow without
+// limit; the recognizer only needs the sites it has seen recently.
+struct VmState {
+  std::unordered_map<int64_t, DispatchSite> dispatch;
+  std::unordered_map<int64_t, BranchSite> branches;
+  FILE* file = nullptr;
+  bool enabled = false;
+  bool initialized = false;
+  uint32_t minHits = 6;
+  uint32_t maxDispatch = 1;
+  bool detectedOnce = false;
+  bool branchDetectedOnce = false;
+  // Manual site selection, matching ruyitrace's DISPATCH_PC / BRANCH_PC. With a
+  // pinned bytecode offset the two engines observe the same instruction, which
+  // is the only way to compare vm_branch counts: autodetection can settle on a
+  // different GetElem of the same loop and then the branches belong to a
+  // different frame.
+  int32_t pinnedDispatchPc = -1;
+  int32_t pinnedBranchPc = -1;
+  // A pinned site waits for the first hit before reporting, so the record can
+  // carry the real hit count instead of a constant.
+  bool pinnedDispatchSeen = false;
+};
+
+VmState& Vm() {
+  static VmState state;
+  if (!state.initialized) {
+    state.initialized = true;
+    // ruyitrace exposes each threshold; the defaults here match what its own
+    // notes say a real VM needs (MIN_HITS default 6, MAX_DISPATCH 1).
+    const char* path = std::getenv("RUYIJS_DOM_JSVMP_TRACE");
+    state.enabled = path && *path && std::strcmp(path, "0") != 0;
+    if (state.enabled) {
+      state.file = DomFamilyHandle() ? DomFamilyHandle() : TraceHandle();
+    }
+    const char* hits = std::getenv("RUYIJS_DOM_JSVMP_MIN_HITS");
+    if (hits && *hits) {
+      state.minHits = uint32_t(std::strtoul(hits, nullptr, 10));
+    }
+    const char* maxd = std::getenv("RUYIJS_DOM_JSVMP_MAX_DISPATCH");
+    if (maxd && *maxd) {
+      state.maxDispatch = uint32_t(std::strtoul(maxd, nullptr, 10));
+    }
+    const char* dpc = std::getenv("RUYIJS_DOM_JSVMP_DISPATCH_PC");
+    if (dpc && *dpc) {
+      state.pinnedDispatchPc = int32_t(std::strtol(dpc, nullptr, 10));
+    }
+    const char* bpc = std::getenv("RUYIJS_DOM_JSVMP_BRANCH_PC");
+    if (bpc && *bpc) {
+      state.pinnedBranchPc = int32_t(std::strtol(bpc, nullptr, 10));
+    }
+  }
+  return state;
+}
+
+void EmitVmRecord(const char* type, int64_t callId, const std::string& body) {
+  VmState& state = Vm();
+  if (!state.file) {
+    return;
+  }
+  static uint64_t seq = 0;
+  std::string record;
+  record.reserve(body.size() + 160);
+  char head[200];
+  std::snprintf(head, sizeof(head),
+                "{\"seq\":%llu,\"ts\":%lld,\"pid\":%lld,\"type\":",
+                static_cast<unsigned long long>(seq++),
+                static_cast<long long>(NowEpochMillis()),
+                static_cast<long long>(CurrentPid()));
+  record.append(head);
+  AppendJsonString(&record, type);
+  char call[48];
+  std::snprintf(call, sizeof(call), ",\"call_id\":%lld", static_cast<long long>(callId));
+  record.append(call);
+  record.append(body);
+  record.append("}\n");
+  Emit(state.file, record);
+}
+
+}  // namespace
+
+void TraceOpcodeVm(JSContext* cx, JSScript* script, jsbytecode* pc,
+                   JS::Value* sp, InterpreterFrame* frame) {
+  VmState& state = Vm();
+  if (!state.enabled || !state.file || !script || !pc) {
+    return;
+  }
+  const JSOp op = JSOp(*pc);
+  const int32_t offset = int32_t(pc - script->code());
+  // Same reasoning as TraceOpcode: the frame chain is the truth here.
+  const int64_t callId =
+      frame ? int64_t(reinterpret_cast<uintptr_t>(frame) & 0x7fffffff) : 0;
+  const int64_t scriptKey = int64_t(reinterpret_cast<uintptr_t>(script));
+
+  // A dispatch site is an indexed load: the instruction a bytecode interpreter
+  // uses to fetch its next opcode, and the point ruyitrace names in
+  // vm_dispatch_detected's dispatch_pc.
+  if (op == JSOp::GetElem || op == JSOp::GetElemSuper) {
+    // With DISPATCH_PC set, only that instruction is the dispatch site, which is
+    // what makes a cross-engine comparison fair: both sides then observe the
+    // same bytecode offset, so any difference in vm_branch comes from the
+    // instrumented payload rather than from site selection.
+    if (state.pinnedDispatchPc >= 0 && offset != state.pinnedDispatchPc) {
+      return;
+    }
+    const int64_t key = scriptKey ^ (int64_t(offset) << 8);
+    DispatchSite& site = state.dispatch[key];
+    site.pc = offset;
+    site.hits += 1;
+    // The pc slot is not recoverable from the opcode alone, so it stays -1 as
+    // in ruyitrace's own record when the immediate is not a local read.
+    if (sp) {
+      const Value& top = sp[-1];
+      if (top.isNumber()) {
+        const double value = top.toNumber();
+        if (site.haveLast && value > site.last) {
+          site.advances += 1;
+        }
+        site.last = value;
+        site.haveLast = true;
+      }
+    }
+    if (state.pinnedDispatchPc >= 0) {
+      // Pinned mode reports on the first hit with the running count, because
+      // the point is to compare payloads, not to exercise the threshold.
+      if (!state.pinnedDispatchSeen) {
+        state.pinnedDispatchSeen = true;
+        char body[192];
+        const double monotonic =
+            site.hits > 1 ? double(site.advances) / double(site.hits - 1) : 0.0;
+        std::snprintf(body, sizeof(body),
+                      ",\"dispatch_pc\":%d,\"pc_slot\":%d,\"pc_kind\":\"local\","
+                      "\"hits\":%u,\"monotonic\":%.3f",
+                      site.pc, site.slot, site.hits, monotonic);
+        EmitVmRecord("vm_dispatch_detected", callId, body);
+      }
+      return;
+    }
+    // ruyitrace emits exactly one detection per process: the first site that
+    // reaches the hit threshold stops further detection. Matching that keeps
+    // the record count comparable.
+    if (!site.detected && site.hits >= state.minHits && !state.detectedOnce) {
+      site.detected = true;
+      state.detectedOnce = true;
+      char body[192];
+      const double monotonic =
+          site.hits > 1 ? double(site.advances) / double(site.hits - 1) : 0.0;
+      std::snprintf(body, sizeof(body),
+                    ",\"dispatch_pc\":%d,\"pc_slot\":%d,\"pc_kind\":\"local\","
+                    "\"hits\":%u,\"monotonic\":%.3f",
+                    site.pc, site.slot, site.hits, monotonic);
+      EmitVmRecord("vm_dispatch_detected", callId, body);
+    }
+  }
+
+  // A branch site is the equality test that decides the next dispatch. ruyitrace
+  // only reports Eq comparisons whose two operands are numbers -- those are the
+  // VM's own opcode dispatch checks, e.g. `instruction == 1`. Reporting every
+  // comparison would inflate the count with ordinary script conditions.
+  if (op == JSOp::Eq && sp) {
+    // A pinned branch pc restricts the payload to that one comparison, so a
+    // count difference against ruyitrace can only come from how often the
+    // instrumented code reaches it.
+    if (state.pinnedBranchPc >= 0 && offset != state.pinnedBranchPc) {
+      return;
+    }
+    const Value rhs = sp[-1];
+    const Value lhs = sp[-2];
+    if (lhs.isNumber() && rhs.isNumber()) {
+      const int64_t key = scriptKey ^ (int64_t(offset) << 8);
+      BranchSite& site = state.branches[key];
+      site.pc = offset;
+      site.hits += 1;
+      const double l = lhs.toNumber(), r = rhs.toNumber();
+      const bool taken = l == r;
+      {
+        char body[192];
+        std::snprintf(body, sizeof(body),
+                      ",\"lhs\":%lld,\"rhs\":%lld,\"cmp\":\"Eq\",\"taken\":%s",
+                      static_cast<long long>(l), static_cast<long long>(r),
+                      taken ? "true" : "false");
+        EmitVmRecord("vm_branch", callId, body);
+      }
+      if (state.pinnedBranchPc >= 0) {
+        return;
+      }
+      if (!site.detected && site.hits >= state.minHits && !state.branchDetectedOnce) {
+        site.detected = true;
+        state.branchDetectedOnce = true;
+        char body[128];
+        std::snprintf(body, sizeof(body), ",\"branch_pc\":%d,\"hits\":%u",
+                      site.pc, site.hits);
+        EmitVmRecord("vm_branch_detected", callId, body);
+      }
+    }
+  }
+}
+
+void TraceOpcode(JSContext* cx, JSScript* script, jsbytecode* pc,
+                 JS::Value* sp, uint32_t stackDepth, InterpreterFrame* frame) {
+  EmitOpcodeRecord(cx, script, pc, sp, stackDepth, frame, "interp", 0);
+}
+
+bool BaselineOpcodeEnabled() {
+  static const bool enabled = [] {
+    std::fprintf(stderr, "[RUYIJS] BaselineOpcodeEnabled probed\n");
+    std::fflush(stderr);
+    static const char* const kNames[] = {"RUYIJS_DOM_JSCALL_OPCODE_URL",
+                                         "RUYIJS_DOM_OPCODE"};
+    for (const char* name : kNames) {
+      const char* value = std::getenv(name);
+      if (value && *value && std::strcmp(value, "0") != 0) {
+        return true;
+      }
+    }
+    return false;
+  }();
+  return enabled;
+}
+
+void BaselineOpcodeTrampoline(void* scriptArg, void* pcArg, int32_t op) {
+  if (!HeavyArmed() || !BaselineOpcodeEnabled()) {
+    return;
+  }
+  JSContext* cx = js::TlsContext.get();
+  if (!cx) {
+    return;
+  }
+  JSScript* script = static_cast<JSScript*>(scriptArg);
+  jsbytecode* pc = static_cast<jsbytecode*>(pcArg);
+  if (!script || !pc) {
+    return;
+  }
+  // Compiled Baseline does not expose its frame pointer at code-generation time.
+  // The frame only feeds call_id and depth, so when the current activation is not
+  // an interpreter activation the op is still recorded with the frame unknown
+  // instead of being dropped.
+  js::InterpreterFrame* frame = nullptr;
+  js::Activation* activation = cx->activation();
+  if (activation && activation->isInterpreter()) {
+    frame = activation->asInterpreter()->current();
+  }
+  EmitOpcodeRecord(cx, script, pc, nullptr, 0, frame, "jit", 0);
+}
+
+void BaselineOpcodeTrampoline2(void* scriptArg, void* pcArg) {
+  if (!HeavyArmed() || !BaselineOpcodeEnabled()) {
+    return;
+  }
+  JSContext* cx = js::TlsContext.get();
+  if (!cx) {
+    return;
+  }
+  JSScript* script = static_cast<JSScript*>(scriptArg);
+  jsbytecode* pc = static_cast<jsbytecode*>(pcArg);
+  if (!script || !pc) {
+    return;
+  }
+  js::InterpreterFrame* frame = nullptr;
+  js::Activation* activation = cx->activation();
+  if (activation && activation->isInterpreter()) {
+    frame = activation->asInterpreter()->current();
+  }
+  EmitOpcodeRecord(cx, script, pc, nullptr, 0, frame, "jit", 0);
+}
+
+void BaselineLoopOpcodeTrampoline(void* pcArg, int32_t op) {
+  if (!HeavyArmed() || !BaselineOpcodeEnabled()) {
+    return;
+  }
+  JSContext* cx = js::TlsContext.get();
+  if (!cx) {
+    return;
+  }
+  jsbytecode* pc = static_cast<jsbytecode*>(pcArg);
+  if (!pc) {
+    return;
+  }
+  // The shared Baseline interpreter emits one loop body for every script, so the
+  // running script is taken from the activation instead of being baked in.
+  js::Activation* activation = cx->activation();
+  if (!activation || !activation->isInterpreter()) {
+    return;
+  }
+  js::InterpreterFrame* frame = activation->asInterpreter()->current();
+  if (!frame) {
+    return;
+  }
+  JSScript* script = frame->script();
+  if (!script) {
+    return;
+  }
+  EmitOpcodeRecord(cx, script, pc, nullptr, 0, frame, "jit", 0);
+}
+
+// The page's `ruyijs` helper object. ruyijs's host_helpers.cpp defines an inert
+// version when this header is absent; when present, this one supplies the same
+// surface plus the registration members, because PageHelpers::Member() /
+// Accessor() / Object() / Interface() call registerMember, registerObject and
+// registerInterface during installation.
+bool DefineRuyijsObject(JSContext* cx, JS::HandleObject holder) {
+  JS::RootedObject object(cx, JS_NewPlainObject(cx));
+  if (!object) {
+    return false;
+  }
+  JS::RootedValue enabled(cx, JS::BooleanValue(TraceHandle() != nullptr));
+  if (!JS_DefineProperty(cx, object, "enabled", enabled, JSPROP_READONLY)) {
+    return false;
+  }
+  auto ignored = [](JSContext* cx, unsigned argc, JS::Value* vp) -> bool {
+    JS::CallArgsFromVp(argc, vp).rval().setUndefined();
+    return true;
+  };
+  auto zero = [](JSContext* cx, unsigned argc, JS::Value* vp) -> bool {
+    JS::CallArgsFromVp(argc, vp).rval().setInt32(0);
+    return true;
+  };
+  static const JSFunctionSpec functions[] = {
+      JS_FN("registerMember", ignored, 4, 0),
+      JS_FN("registerObject", ignored, 2, 0),
+      JS_FN("registerInterface", zero, 2, 0),
+      JS_FN("makeConfigurable", ignored, 2, 0),
+      JS_FS_END,
+  };
+  if (!JS_DefineFunctions(cx, object, functions)) {
+    return false;
+  }
+  return JS_DefineProperty(cx, holder, "ruyijs", object, 0);
+}
