+void TraceWasmModule(JSContext* cx, const void* module, const char* api,
+                     const char* op, const char* phase) {
+  FILE* file = WasmHandle();
+  if (!file) {
+    return;
+  }
+  static uint64_t emitted = 0;
+  const uint64_t limit = [] {
+    const char* text = std::getenv("RUYIJS_DOM_WASM_TRACE_LIMIT");
+    return text && *text ? std::strtoull(text, nullptr, 10) : 0ull;
+  }();
+  if (limit > 0 && emitted >= limit) {
+    EmitLimitReached(file, "wasm", limit);
+    return;
+  }
+
+  // An already-compiled module carries no source bytes, so the record reports the
+  // module pointer hash as its identity and leaves the byte fields empty. That is
+  // what ruyitrace does with moduleIdSource "module_ptr_hash" and dumpReason
+  // "metadata_only".
+  char moduleId[24];
+  std::snprintf(moduleId, sizeof(moduleId), "%016llx",
+                static_cast<unsigned long long>(
+                    reinterpret_cast<uintptr_t>(module)));
+
+  std::string record;
+  record.reserve(640);
+  record.append("{\"schemaVersion\":1,\"seq\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(emitted++));
+  record.append(",\"ts\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(RecordTs()));
+  record.append(",\"pid\":");
+  AppendNumber(&record, "%d", static_cast<long long>(CurrentPid()));
+  record.append(",\"process_type\":\"tab\",\"type\":\"wasm\",\"op\":");
+  AppendJsonString(&record, op);
+  record.append(",\"api\":");
+  AppendJsonString(&record, api);
+  record.append(",\"phase\":");
+  AppendJsonString(&record, phase);
+  record.append(",\"sourceKind\":\"module\",\"ok\":true");
+  record.append(",\"moduleIdSource\":\"module_ptr_hash\",\"moduleId\":");
+  AppendJsonString(&record, moduleId);
+  record.append(",\"moduleObjectId\":\"\",\"instanceId\":\"\"");
+  record.append(",\"byteLength\":0,\"sha256\":\"\",\"headHex\":\"\",\"file\":\"\"");
+  record.append(",\"dumped\":false,\"dumpReason\":\"metadata_only\"");
+  record.append(",\"importsCount\":0,\"exportsCount\":0,\"funcCount\":0");
+  record.append(",\"memoryCount\":0,\"tableCount\":0,\"globalCount\":0");
+  record.append(",\"tagCount\":0,\"truncated\":false");
+  record.append(",\"importsSample\":[],\"exportsSample\":[],\"stack\":[]}\n");
+  Emit(file, record);
+}
+
+void TraceWasmBytes(JSContext* cx, const uint8_t* bytes, size_t length,
+                    const char* api, const char* op, const char* phase) {
+  FILE* file = WasmHandle();
+  if (!file || !bytes || !length) {
+    return;
+  }
+  static uint64_t emitted = 0;
+  const uint64_t limit = [] {
+    const char* text = std::getenv("RUYIJS_DOM_WASM_TRACE_LIMIT");
+    return text && *text ? std::strtoull(text, nullptr, 10) : 0ull;
+  }();
+  if (limit > 0 && emitted >= limit) {
+    EmitLimitReached(file, "wasm", limit);
+    return;
+  }
+
+  const std::string sha = Sha256Hex(bytes, length);
+  static const char kDigits[] = "0123456789abcdef";
+  const size_t headLength = length < 16 ? length : 16;
+  std::string head;
+  head.reserve(headLength * 2);
+  for (size_t i = 0; i < headLength; ++i) {
+    head.push_back(kDigits[bytes[i] >> 4]);
+    head.push_back(kDigits[bytes[i] & 0xf]);
+  }
+
+  // Dumping is deduplicated by content hash: the same module compiled twice lands
+  // on the same file, so the second write is skipped and reported as a duplicate.
+  bool dumped = false;
+  std::string fileName;
+  const char* dumpReason = "";
+  if (!WasmDumpEnabled()) {
+    dumpReason = "disabled";
+  } else if (length > WasmDumpMax()) {
+    dumpReason = "over_module_limit";
+  } else if (WasmDumpedTotal() + length > WasmDumpTotal()) {
+    dumpReason = "over_total_limit";
+  } else {
+    const char* dir = std::getenv("RUYIJS_DOM_WASM_DUMP_DIR");
+    std::string path;
+    if (dir && *dir) {
+      path.assign(dir);
+      if (path.back() != '/' && path.back() != '\\') {
+        path.push_back('/');
+      }
+    }
+    path.append("wasm_");
+    path.append(sha);
+    path.push_back('_');
+    AppendNumber(&path, "%lld", static_cast<long long>(length));
+    path.append(".wasm");
+    if (FILE* existing = std::fopen(path.c_str(), "rb")) {
+      std::fclose(existing);
+      dumpReason = "dedup";
+    } else if (FILE* out = std::fopen(path.c_str(), "wb")) {
+      const size_t written = std::fwrite(bytes, 1, length, out);
+      std::fclose(out);
+      if (written == length) {
+        dumped = true;
+        fileName = path;
+        WasmDumpedTotal() += length;
+      } else {
+        dumpReason = "write_failed";
+      }
+    } else {
+      dumpReason = "open_failed";
+    }
+  }
+
+  std::string record;
+  record.reserve(768);
+  record.append("{\"schemaVersion\":1,\"seq\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(emitted++));
+  record.append(",\"ts\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(RecordTs()));
+  record.append(",\"pid\":");
+  AppendNumber(&record, "%d", static_cast<long long>(CurrentPid()));
+  // ruyijs hosts one page per process, so the kernel's process type is always the
+  // content process; kept for schema parity.
+  record.append(",\"process_type\":\"tab\",\"type\":\"wasm\",\"op\":");
+  AppendJsonString(&record, op);
+  record.append(",\"api\":");
+  AppendJsonString(&record, api);
+  record.append(",\"phase\":");
+  AppendJsonString(&record, phase);
+  record.append(",\"sourceKind\":\"buffer\",\"ok\":true");
+  // Before compilation the bytes are the only identity available, which is what
+  // ruyitrace calls bytes_pending.
+  record.append(",\"moduleIdSource\":\"bytes_pending\",\"moduleId\":\"\"");
+  record.append(",\"moduleObjectId\":\"\",\"instanceId\":\"\"");
+  record.append(",\"byteLength\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(length));
+  record.append(",\"sha256\":");
+  AppendJsonString(&record, sha.c_str());
+  record.append(",\"headHex\":");
+  AppendJsonString(&record, head.c_str());
+  record.append(",\"file\":");
+  AppendJsonString(&record, fileName.c_str());
+  record.append(dumped ? ",\"dumped\":true" : ",\"dumped\":false");
+  record.append(",\"dumpReason\":");
+  AppendJsonString(&record, dumpReason);
+  record.append(",\"importsCount\":0,\"exportsCount\":0,\"funcCount\":0");
+  record.append(",\"memoryCount\":0,\"tableCount\":0,\"globalCount\":0");
+  record.append(",\"tagCount\":0,\"truncated\":false");
+  record.append(",\"importsSample\":[],\"exportsSample\":[],\"stack\":[]}\n");
+  Emit(file, record);
+}
