+}  // namespace standalone_trace
+}  // namespace js
+
+extern "C" bool RuyijsProConfigure(int argc, char** argv) {
+  using namespace js::standalone_trace;
+  ProConfig& config = Pro();
+  if (config.configured) return !config.invalid;
+  config.configured = true;
+  if (ProEnv("RUYIJS_PRO_STANDALONE_TRACE_DISABLE")) return true;
+  ProResolveEnvironment(&config);
+  ProApplyCli(&config, argc, argv);
+  if (!ProParseCategories(config.categories, &config.bits)) {
+    config.invalid = true;
+    std::fprintf(stderr, "Unknown standalone trace category: %s\n",
+                 config.categories.c_str());
+    return false;
+  }
+  const char* add = ProEnv("RUYIJS_TRACE");
+  if (add && std::strcmp(add, "0") != 0) config.bits |= 16;
+  if (config.file.empty()) return true;
+  config.enabled = true;
+  return true;
+}
+
+extern "C" void RuyijsProStart() {
+  using namespace js::standalone_trace;
+  ProConfig& config = Pro();
+  if (!config.enabled || config.started || config.invalid || config.file.empty()) return;
+  config.handle = std::fopen(config.file.c_str(), "wb");
+  if (!config.handle) return;
+  config.started = true;
+  std::string body = ",\"metadata\":{\"host\":\"standalone-kernel\",\"categories\":";
+  ProJson(&body, config.categories.c_str());
+  body += ",\"target\":";
+  ProJson(&body, config.target.c_str());
+  body += "},\"depth\":0";
+  ProWrite("session_started", body, true);
+}
+
+extern "C" void RuyijsProStop() {
+  using namespace js::standalone_trace;
+  ProConfig& config = Pro();
+  if (!config.started || config.stopped) return;
+  std::string body = ",\"status\":\"ok\",\"event_count\":";
+  ProNumber(&body, "%lld", static_cast<long long>(config.emitted));
+  body += ",\"depth\":0";
+  ProWrite("session_stopped", body, true);
+  config.stopped = true;
+  std::fflush(config.handle);
+  std::fclose(config.handle);
+  config.handle = nullptr;
+}
+
+extern "C" void RuyijsProEmitPageEvents(const char* url) {
+  using namespace js::standalone_trace;
+  ProConfig& config = Pro();
+  if (!ProRunning()) return;
+  if (url && *url) config.pageUrl = url;
+  ProPageLongString();
+  ProDeterministicRegistry();
+}
+
+extern "C" void RuyijsProRegistry(const char* kind, const char* iface,
+                                   const char* member, const char* valueText,
+                                   const char* valueObjText, const char* returnText,
+                                   const char* returnObjText, const char* thisText,
+                                   const char* argsText, const char* postArgsText) {
+  using namespace js::standalone_trace;
+  if (kind && *kind) {
+    ProRegistryLine(kind, iface, member, valueText, valueObjText, returnText,
+                    returnObjText, thisText, argsText, postArgsText);
+  }
+}
