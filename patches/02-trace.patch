+// ---------------------------------------------------------------------------
+// WASM layer
+//
+// ruyitrace reports one document per stage of a module's life. The bytes are the
+// only part the engine can describe at the compile entry point, so identity is
+// carried as length + sha256 + a 16-byte head, plus a dump file named after the
+// hash. Dumping is on by default in the kernel and bounded by two size limits.
+// ---------------------------------------------------------------------------
+
+namespace {
+
+FILE* WasmHandle() {
+  static FILE* file = []() -> FILE* {
+    const char* path = std::getenv("RUYIJS_DOM_WASM_TRACE");
+    if (!path || !*path) {
+      return nullptr;
+    }
+    return std::fopen(path, "ab");
+  }();
+  return file;
+}
+
+uint64_t WasmDumpMax() {
+  static const uint64_t value = []() -> uint64_t {
+    const char* text = std::getenv("RUYIJS_DOM_WASM_DUMP_MAX");
+    return text && *text ? std::strtoull(text, nullptr, 10) : 8388608ull;
+  }();
+  return value;
+}
+
+uint64_t WasmDumpTotal() {
+  static const uint64_t value = []() -> uint64_t {
+    const char* text = std::getenv("RUYIJS_DOM_WASM_DUMP_TOTAL");
+    return text && *text ? std::strtoull(text, nullptr, 10) : 134217728ull;
+  }();
+  return value;
+}
+
+bool WasmDumpEnabled() {
+  static const bool enabled = []() {
+    const char* text = std::getenv("RUYIJS_DOM_WASM_DUMP");
+    if (!text || !*text) {
+      return true;
+    }
+    return std::strcmp(text, "0") != 0;
+  }();
+  return enabled;
+}
+
+uint64_t& WasmDumpedTotal() {
+  static uint64_t total = 0;
+  return total;
+}
+
+// SHA-256 over the module bytes. The engine's own implementation sits behind a
+// wasm-specific API that is not reachable here, and the host side needs the same
+// digest, so a local copy keeps both sides byte-identical.
+void Sha256Block(uint32_t* state, const uint8_t* block) {
+  static const uint32_t k[64] = {
+      0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1,
+      0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
+      0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786,
+      0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+      0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147,
+      0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
+      0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b,
+      0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+      0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a,
+      0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
+      0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2};
+  auto rotr = [](uint32_t v, uint32_t n) { return (v >> n) | (v << (32 - n)); };
+  uint32_t w[64];
+  for (int i = 0; i < 16; ++i) {
+    w[i] = (uint32_t(block[i * 4]) << 24) | (uint32_t(block[i * 4 + 1]) << 16) |
+           (uint32_t(block[i * 4 + 2]) << 8) | uint32_t(block[i * 4 + 3]);
+  }
+  for (int i = 16; i < 64; ++i) {
+    const uint32_t s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >> 3);
+    const uint32_t s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >> 10);
+    w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+  }
+  uint32_t a = state[0], b = state[1], c = state[2], d = state[3];
+  uint32_t e = state[4], f = state[5], g = state[6], h = state[7];
+  for (int i = 0; i < 64; ++i) {
+    const uint32_t s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
+    const uint32_t ch = (e & f) ^ (~e & g);
+    const uint32_t t1 = h + s1 + ch + k[i] + w[i];
+    const uint32_t s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
+    const uint32_t maj = (a & b) ^ (a & c) ^ (b & c);
+    const uint32_t t2 = s0 + maj;
+    h = g; g = f; f = e; e = d + t1;
+    d = c; c = b; b = a; a = t1 + t2;
+  }
+  state[0] += a; state[1] += b; state[2] += c; state[3] += d;
+  state[4] += e; state[5] += f; state[6] += g; state[7] += h;
+}
+
+std::string Sha256Hex(const uint8_t* data, size_t length) {
+  uint32_t state[8] = {0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
+                       0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19};
+  size_t offset = 0;
+  while (offset + 64 <= length) {
+    Sha256Block(state, data + offset);
+    offset += 64;
+  }
+  uint8_t tail[128] = {};
+  const size_t remain = length - offset;
+  std::memcpy(tail, data + offset, remain);
+  tail[remain] = 0x80;
+  const size_t tailBlocks = (remain + 9 <= 64) ? 1 : 2;
+  const uint64_t bits = uint64_t(length) * 8;
+  for (int i = 0; i < 8; ++i) {
+    tail[tailBlocks * 64 - 1 - i] = uint8_t((bits >> (i * 8)) & 0xff);
+  }
+  for (size_t i = 0; i < tailBlocks; ++i) {
+    Sha256Block(state, tail + i * 64);
+  }
+  static const char kDigits[] = "0123456789abcdef";
+  std::string hex;
+  hex.reserve(64);
+  for (int i = 0; i < 8; ++i) {
+    for (int shift = 28; shift >= 0; shift -= 4) {
+      hex.push_back(kDigits[(state[i] >> shift) & 0xf]);
+    }
+  }
+  return hex;
+}
