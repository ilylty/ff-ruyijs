+}  // namespace
+
+void TraceWasmResolve(JSContext* cx, uint32_t importsCount,
+                      const WasmCounts& counts, JS::HandleObject exports) {
+  FILE* file = WasmHandle();
+  if (!file) {
+    return;
+  }
+  static uint64_t emitted = 0;
+  const uint64_t limit = [] {
+    const char* text = std::getenv("RUYIJS_DOM_WASM_TRACE_LIMIT");
+    return text && *text ? std::strtoull(text, nullptr, 10) : 0ull;
+  }();
+  if (limit > 0 && emitted >= limit) {
+    EmitLimitReached(file, "wasm", limit);
+    return;
+  }
+
+  // Import resolution finishes at the point the instance becomes usable, so this
+  // record reports both halves: how many imports were satisfied and what the
+  // resulting exports look like.
+  std::string sample;
+  uint32_t exportsCount = counts.exportsCount;
+  uint32_t funcCount = counts.funcCount;
+  uint32_t memoryCount = counts.memoryCount;
+  bool truncated = counts.truncated;
+  const size_t kMaxSample = 20;
+  if (exports) {
+    JS::RootedIdVector keys(cx);
+    if (GetPropertyKeys(cx, exports, JSITER_OWNONLY, &keys)) {
+      for (size_t i = 0; i < keys.length(); ++i) {
+        JS::RootedId id(cx, keys[i]);
+        JS::RootedValue keyValue(cx);
+        if (!JS_IdToValue(cx, id, &keyValue)) {
+          JS_ClearPendingException(cx);
+          continue;
+        }
+        JS::RootedString keyString(cx, JS::ToString(cx, keyValue));
+        if (!keyString) {
+          JS_ClearPendingException(cx);
+          continue;
+        }
+        JS::UniqueChars name = JS_EncodeStringToUTF8(cx, keyString);
+        if (!name) {
+          JS_ClearPendingException(cx);
+          continue;
+        }
+        JS::RootedValue value(cx);
+        if (!JS_GetPropertyById(cx, exports, id, &value)) {
+          JS_ClearPendingException(cx);
+          continue;
+        }
+        const char* kind = "other";
+        if (value.isObject()) {
+          JS::RootedObject object(cx, &value.toObject());
+          if (JS::IsCallable(object)) {
+            kind = "function";
+          } else {
+            const JSClass* clasp = JS::GetClass(object);
+            const char* className = clasp && clasp->name ? clasp->name : "";
+            if (!std::strcmp(className, "WebAssembly.Memory")) {
+              kind = "memory";
+            }
+          }
+        }
+        if (i < kMaxSample) {
+          if (!sample.empty()) {
+            sample.push_back(',');
+          }
+          sample.append("{\"name\":");
+          AppendJsonString(&sample, name.get());
+          sample.append(",\"kind\":");
+          AppendJsonString(&sample, kind);
+          sample.push_back('}');
+        } else {
+          truncated = true;
+        }
+      }
+    } else {
+      JS_ClearPendingException(cx);
+    }
+  }
+
+  std::string record;
+  record.reserve(512);
+  record.append("{\"schemaVersion\":1,\"seq\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(emitted++));
+  record.append(",\"ts\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(RecordTs()));
+  record.append(",\"pid\":");
+  AppendNumber(&record, "%d", static_cast<long long>(CurrentPid()));
+  record.append(",\"process_type\":\"tab\",\"type\":\"wasm\",\"op\":\"imports_resolve\",\"api\":\"WebAssembly.instantiate\"");
+  record.append(",\"phase\":\"success\",\"sourceKind\":\"buffer\",\"ok\":true");
+  record.append(",\"moduleIdSource\":\"\",\"moduleId\":\"\"");
+  record.append(",\"moduleObjectId\":\"\",\"instanceId\":\"\"");
+  record.append(",\"byteLength\":0,\"sha256\":\"\",\"headHex\":\"\",\"file\":\"\"");
+  record.append(",\"dumped\":false,\"dumpReason\":\"metadata_only\"");
+  record.append(",\"importsCount\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(importsCount));
+  record.append(",\"exportsCount\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(exportsCount));
+  record.append(",\"funcCount\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(funcCount));
+  record.append(",\"memoryCount\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(memoryCount));
+  record.append(",\"tableCount\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(counts.tableCount));
+  record.append(",\"globalCount\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(counts.globalCount));
+  record.append(",\"tagCount\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(counts.tagCount));
+  record.append(",\"truncated\":");
+  record.append(truncated ? "true" : "false");
+  record.append(",\"importsSample\":[],\"exportsSample\":[");
+  record.append(sample);
+  record.append("],\"stack\":[]}\n");
+  Emit(file, record);
+}
+
+void TraceWasmExports(JSContext* cx, JS::HandleObject exports,
+                      const char* api) {
+  FILE* file = WasmHandle();
+  if (!file || !exports) {
+    return;
+  }
+  static uint64_t emitted = 0;
+  const uint64_t limit = [] {
+    const char* text = std::getenv("RUYIJS_DOM_WASM_TRACE_LIMIT");
+    return text && *text ? std::strtoull(text, nullptr, 10) : 0ull;
+  }();
+  if (limit > 0 && emitted >= limit) {
+    EmitLimitReached(file, "wasm", limit);
+    return;
+  }
+
+  // The exports object's own keys are the module's exports. The kind is derived
+  // from the value: functions and memories are the only two the record names, and
+  // anything else is reported as "other" rather than omitted.
+  JS::RootedIdVector keys(cx);
+  if (!js::GetPropertyKeys(cx, exports, JSITER_OWNONLY, &keys)) {
+    JS_ClearPendingException(cx);
+    return;
+  }
+
+  std::string sample;
+  bool first = true;
+  uint32_t funcCount = 0;
+  uint32_t memoryCount = 0;
+  const uint32_t exportsCount = 0;  // ruyitrace leaves this zero on this stage
+  const size_t kMaxSample = 20;
+  for (size_t i = 0; i < keys.length(); ++i) {
+    JS::RootedId id(cx, keys[i]);
+    JS::RootedValue keyValue(cx);
+    if (!JS_IdToValue(cx, id, &keyValue)) {
+      JS_ClearPendingException(cx);
+      continue;
+    }
+    JS::RootedString keyString(cx, JS::ToString(cx, keyValue));
+    if (!keyString) {
+      JS_ClearPendingException(cx);
+      continue;
+    }
+    JS::UniqueChars name = JS_EncodeStringToUTF8(cx, keyString);
+    if (!name) {
+      JS_ClearPendingException(cx);
+      continue;
+    }
+    JS::RootedValue value(cx);
+    if (!JS_GetPropertyById(cx, exports, id, &value)) {
+      JS_ClearPendingException(cx);
+      continue;
+    }
+    const char* kind = "other";
+    if (value.isObject()) {
+      JS::RootedObject object(cx, &value.toObject());
+      if (JS::IsCallable(object)) {
+        kind = "function";
+        ++funcCount;
+      } else {
+        const JSClass* clasp = JS::GetClass(object);
+        const char* className = clasp && clasp->name ? clasp->name : "";
+        if (!std::strcmp(className, "WebAssembly.Memory")) {
+          kind = "memory";
+          ++memoryCount;
+        }
+      }
+    }
+    if (i < kMaxSample) {
+      if (!first) {
+        sample.push_back(',');
+      }
+      first = false;
+      sample.append("{\"name\":");
+      AppendJsonString(&sample, name.get());
+      sample.append(",\"kind\":");
+      AppendJsonString(&sample, kind);
+      sample.push_back('}');
+    }
+  }
+
+  std::string record;
+  record.reserve(512);
+  record.append("{\"schemaVersion\":1,\"seq\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(emitted++));
+  record.append(",\"ts\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(RecordTs()));
+  record.append(",\"pid\":");
+  AppendNumber(&record, "%d", static_cast<long long>(CurrentPid()));
+  record.append(",\"process_type\":\"tab\",\"type\":\"wasm\",\"op\":\"exports_read\",\"api\":");
+  AppendJsonString(&record, api);
+  record.append(",\"phase\":\"get\",\"sourceKind\":\"module\",\"ok\":true");
+  record.append(",\"moduleIdSource\":\"\",\"moduleId\":\"\"");
+  record.append(",\"moduleObjectId\":\"\",\"instanceId\":\"\"");
+  record.append(",\"byteLength\":0,\"sha256\":\"\",\"headHex\":\"\",\"file\":\"\"");
+  record.append(",\"dumped\":false,\"dumpReason\":\"metadata_only\"");
+  record.append(",\"importsCount\":0,\"exportsCount\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(exportsCount));
+  record.append(",\"funcCount\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(funcCount));
+  record.append(",\"memoryCount\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(memoryCount));
+  record.append(",\"tableCount\":0,\"globalCount\":0,\"tagCount\":0");
+  record.append(",\"truncated\":");
+  record.append(keys.length() > kMaxSample ? "true" : "false");
+  record.append(",\"importsSample\":[],\"exportsSample\":[");
+  record.append(sample);
+  record.append("],\"stack\":[]}\n");
+  Emit(file, record);
+}
+
+// ruyitrace reports a console call as its member name, one array entry per
+// argument, and the JS call site. The arguments are rendered here because they
+// are alive only during the call, and the site is read here because the console
+// frame is still on the stack at this point.
+void TraceConsoleCall(JSContext* cx, const char* method, JS::CallArgs& args) {
+  static bool initialized = false;
+  static FILE* file = nullptr;
+  static uint64_t emitted = 0;
+  static uint64_t limit = 0;
+  if (!initialized) {
+    initialized = true;
+    const char* path = std::getenv("RUYIJS_DOM_CONSOLE");
+    if (!path || !*path) {
+      path = std::getenv("RUYIJS_CONSOLE_TRACE");
+    }
+    if (path && *path) {
+      file = std::fopen(path, "ab");
+    }
+    const char* text = std::getenv("RUYIJS_DOM_CONSOLE_LIMIT");
+    limit = text && *text ? static_cast<uint64_t>(std::strtoull(text, nullptr, 10)) : 0;
+  }
+  if (!file) {
+    return;
+  }
+  if (limit > 0 && emitted >= limit) {
+    EmitLimitReached(file, "console", limit);
+    return;
+  }
+  ++emitted;
+
+  std::string arguments;
+  const size_t kMaxArgs = 20;
+  for (size_t i = 0; i < args.length() && i < kMaxArgs; ++i) {
+    if (i) {
+      arguments.push_back(',');
+    }
+    AppendValueSummary(cx, &arguments, args[i], 0);
+  }
+
+  JS::AutoFilename source;
+  unsigned line = 0;
+  JS::ColumnNumberOneOrigin column;
+  std::string fileText;
+  if (JS::DescribeScriptedCaller(&source, cx, &line, &column)) {
+    if (source.get()) {
+      fileText.assign(source.get());
+    }
+  } else {
+    JS_ClearPendingException(cx);
+  }
+
+  std::string record;
+  record.reserve(256);
+  record.append("{\"seq\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(NextDomSeq()));
+  record.append(",\"ts\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(RecordTs()));
+  record.append(",\"pid\":");
+  AppendNumber(&record, "%d", static_cast<long long>(CurrentPid()));
+  record.append(",\"type\":\"console\",\"method\":");
+  AppendJsonString(&record, method);
+  record.append(",\"args\":[");
+  record.append(arguments);
+  record.append("],\"file\":");
+  AppendJsonString(&record, fileText.c_str());
+  record.append(",\"line\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(line));
+  record.append("}\n");
+  Emit(file, record);
+}
+
+void TraceWasmComplete(JSContext* cx, const void* module, const char* api,
+                       const char* op, const char* phase,
+                       const WasmCounts& counts) {
+  FILE* file = WasmHandle();
+  if (!file) {
+    return;
+  }
+  static uint64_t emitted = 0;
+  const uint64_t limit = [] {
+    const char* text = std::getenv("RUYIJS_DOM_WASM_TRACE_LIMIT");
+    return text && *text ? std::strtoull(text, nullptr, 10) : 0ull;
+  }();
+  if (limit > 0 && emitted >= limit) {
+    EmitLimitReached(file, "wasm", limit);
+    return;
+  }
+
+  char moduleId[24];
+  std::snprintf(moduleId, sizeof(moduleId), "%016llx",
+                static_cast<unsigned long long>(
+                    reinterpret_cast<uintptr_t>(module)));
+
+  std::string record;
+  record.reserve(512);
+  record.append("{\"schemaVersion\":1,\"seq\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(emitted++));
+  record.append(",\"ts\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(RecordTs()));
+  record.append(",\"pid\":");
+  AppendNumber(&record, "%d", static_cast<long long>(CurrentPid()));
+  record.append(",\"process_type\":\"tab\",\"type\":\"wasm\",\"op\":");
+  AppendJsonString(&record, op);
+  record.append(",\"api\":");
+  AppendJsonString(&record, api);
+  record.append(",\"phase\":");
+  AppendJsonString(&record, phase);
+  record.append(",\"sourceKind\":\"buffer\",\"ok\":true");
+  record.append(",\"moduleIdSource\":\"module_ptr_hash\",\"moduleId\":");
+  AppendJsonString(&record, moduleId);
+  record.append(",\"moduleObjectId\":\"\",\"instanceId\":\"\"");
+  record.append(",\"byteLength\":0,\"sha256\":\"\",\"headHex\":\"\",\"file\":\"\"");
+  record.append(",\"dumped\":false,\"dumpReason\":\"metadata_only\"");
+  record.append(",\"importsCount\":0,\"exportsCount\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(counts.exportsCount));
+  record.append(",\"funcCount\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(counts.funcCount));
+  record.append(",\"memoryCount\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(counts.memoryCount));
+  record.append(",\"tableCount\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(counts.tableCount));
+  record.append(",\"globalCount\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(counts.globalCount));
+  record.append(",\"tagCount\":");
+  AppendNumber(&record, "%lld", static_cast<long long>(counts.tagCount));
+  record.append(",\"truncated\":");
+  record.append(counts.truncated ? "true" : "false");
+  record.append(",\"importsSample\":[],\"exportsSample\":[],\"stack\":[]}\n");
+  Emit(file, record);
+}
