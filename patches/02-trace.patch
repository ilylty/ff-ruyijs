+namespace js {
+namespace standalone_trace {
+namespace {
+
+struct ProConfig {
+  bool configured = false;
+  bool enabled = false;
+  bool invalid = false;
+  bool started = false;
+  bool stopped = false;
+  bool time = true;
+  bool fileFromEnv = false;
+  bool limitRecorded = false;
+  bool registryInit = false;
+  bool deterministicRegistry = false;
+  std::string file;
+  std::string categories;
+  std::string target;
+  std::string runId = "standalone-kernel";
+  std::string hostSubstring;
+  std::string pageUrl;
+  unsigned long long bits = 0;
+  unsigned long long limit = 0;
+  unsigned long long maxValue = 0;
+  unsigned long long maxItems = 0;
+  unsigned long long emitted = 0;
+  unsigned long long seq = 0;
+  unsigned long long callId = 0;
+  unsigned long long boundaryId = 0;
+  FILE* handle = nullptr;
+};
+
+ProConfig& Pro() {
+  static ProConfig config;
+  return config;
+}
+
+struct ProStack {
+  uint64_t current = 0;
+  int32_t depth = 0;
+};
+
+ProStack& ProCallStack() {
+  static ProStack stack;
+  return stack;
+}
+
+long long ProPid() {
+#ifdef XP_WIN
+  return static_cast<long long>(GetCurrentProcessId());
+#else
+  return static_cast<long long>(getpid());
+#endif
+}
+
+long long ProEpoch() {
+  return static_cast<long long>(
+      std::chrono::duration_cast<std::chrono::milliseconds>(
+          std::chrono::system_clock::now().time_since_epoch()).count());
+}
+
+void ProNumber(std::string* out, const char* format, long long value) {
+  char buffer[64];
+  std::snprintf(buffer, sizeof(buffer), format, value);
+  out->append(buffer);
+}
+
+void ProJson(std::string* out, const char* text) {
+  out->push_back('"');
+  for (const char* p = text ? text : ""; *p; ++p) {
+    const unsigned char c = static_cast<unsigned char>(*p);
+    switch (c) {
+      case '"': out->append("\\\""); break;
+      case '\\': out->append("\\\\"); break;
+      case '\n': out->append("\\n"); break;
+      case '\r': out->append("\\r"); break;
+      case '\t': out->append("\\t"); break;
+      default:
+        if (c < 0x20) {
+          char buffer[8];
+          std::snprintf(buffer, sizeof(buffer), "\\u%04x", c);
+          out->append(buffer);
+        } else {
+          out->push_back(static_cast<char>(c));
+        }
+    }
+  }
+  out->push_back('"');
+}
+
+std::string ProLower(std::string text) {
+  std::transform(text.begin(), text.end(), text.begin(), [](unsigned char c) {
+    return static_cast<char>(std::tolower(c));
+  });
+  return text;
+}
+
+std::vector<std::string> ProSplit(const std::string& text, char separator) {
+  std::vector<std::string> parts;
+  size_t start = 0;
+  while (start <= text.size()) {
+    size_t end = text.find(separator, start);
+    if (end == std::string::npos) end = text.size();
+    parts.push_back(text.substr(start, end - start));
+    if (end == text.size()) break;
+    start = end + 1;
+  }
+  return parts;
+}
+
+const char* ProEnv(const char* key) {
+  const char* value = std::getenv(key);
+  return value && *value ? value : nullptr;
+}
+
+unsigned long long ProUll(const char* text, unsigned long long fallback = 0) {
+  if (!text || !*text) return fallback;
+  char* end = nullptr;
+  unsigned long long value = std::strtoull(text, &end, 10);
+  return end == text ? fallback : value;
+}
+
+bool ProTruthy(const char* text) {
+  return text && *text && std::strcmp(text, "0") != 0;
+}
+
+bool ProCategory(const std::string& word, unsigned long long* bit) {
+  const std::string name = ProLower(word);
+  if (name == "jscall" || name == "call") *bit = 1;
+  else if (name == "reflect" || name == "reflection") *bit = 2;
+  else if (name == "eval" || name == "dynamic" || name == "dynamic-code") *bit = 4;
+  else if (name == "wasm") *bit = 8;
+  else if (name == "ruyijs" || name == "host" || name == "domtrace") *bit = 16;
+  else if (name == "jsonbytes") *bit = 32;
+  else if (name == "all" || name == "1") *bit = 15;
+  else return false;
+  return true;
+}
+
+bool ProParseCategories(const std::string& text, unsigned long long* bits) {
+  *bits = 0;
+  for (const std::string& part : ProSplit(text, ',')) {
+    if (part.empty()) continue;
+    unsigned long long bit = 0;
+    if (!ProCategory(part, &bit)) return false;
+    *bits |= bit;
+  }
+  return true;
+}
+
+bool ProTargetAllows(const std::string& url) {
+  const ProConfig& config = Pro();
+  if (config.target.empty()) return true;
+  for (const std::string& part : ProSplit(config.target, ',')) {
+    if (!part.empty() && url.find(part) != std::string::npos) return true;
+  }
+  return false;
+}
+
+bool ProRunning() {
+  const ProConfig& config = Pro();
+  return config.configured && config.enabled && !config.invalid &&
+         config.started && !config.stopped && config.handle;
+}
+
+bool ProWrite(const char* type, const std::string& body, bool force = false) {
+  ProConfig& config = Pro();
+  if (!config.started || config.stopped || !config.handle) return false;
+  if (!force && config.limit > 0 && config.emitted >= config.limit) {
+    if (!config.limitRecorded) {
+      config.limitRecorded = true;
+      std::string limitBody = ",\"reason\":\"event_limit\",\"attempted_type\":";
+      ProJson(&limitBody, type);
+      ProWrite("limit_reached", limitBody, true);
+    }
+    return false;
+  }
+  std::string line = "{\"schema\":1,\"run_id\":";
+  ProJson(&line, config.runId.c_str());
+  line += ",\"seq\":";
+  ProNumber(&line, "%lld", static_cast<long long>(++config.seq));
+  line += ",\"type\":";
+  ProJson(&line, type);
+  if (config.time) {
+    line += ",\"ts\":";
+    ProNumber(&line, "%lld", ProEpoch());
+  }
+  line += ",\"pid\":";
+  ProNumber(&line, "%d", ProPid());
+  line += body + "}\n";
+  std::fwrite(line.data(), 1, line.size(), config.handle);
+  std::fflush(config.handle);
+  if (!force) ++config.emitted;
+  return true;
+}
+
+void ProStringValue(const std::string& value, std::string* out) {
+  ProConfig& config = Pro();
+  out->append("{\"type\":\"string\",\"length\":");
+  ProNumber(out, "%lld", static_cast<long long>(value.size()));
+  if (config.maxValue > 0 && value.size() > config.maxValue) {
+    const size_t keep = std::min<size_t>(128, value.size());
+    out->append(",\"head\":");
+    ProJson(out, value.substr(0, keep).c_str());
+    out->append(",\"tail\":");
+    ProJson(out, value.substr(value.size() - keep).c_str());
+  } else {
+    out->append(",\"value\":");
+    ProJson(out, value.c_str());
+  }
+  out->push_back('}');
+}
+
+void ProValueText(JSContext* cx, const JS::Value& value, std::string* out) {
+  if (value.isUndefined()) { out->append("{\"type\":\"undefined\"}"); return; }
+  if (value.isNull()) { out->append("{\"type\":\"null\"}"); return; }
+  if (value.isBoolean()) {
+    out->append("{\"type\":\"boolean\",\"value\":");
+    out->append(value.toBoolean() ? "true" : "false");
+    out->push_back('}');
+    return;
+  }
+  if (value.isInt32() || value.isDouble()) {
+    out->append("{\"type\":\"number\",\"value\":");
+    if (value.isInt32()) ProNumber(out, "%d", value.toInt32());
+    else {
+      char buffer[40];
+      std::snprintf(buffer, sizeof(buffer), "%.17g", value.toDouble());
+      out->append(buffer);
+    }
+    out->push_back('}');
+    return;
+  }
+  if (value.isString()) {
+    JS::RootedString text(cx, value.toString());
+    JS::UniqueChars utf8 = JS_EncodeStringToUTF8(cx, text);
+    if (!utf8) { JS_ClearPendingException(cx); ProStringValue("", out); return; }
+    ProStringValue(std::string(utf8.get()), out);
+    return;
+  }
+  if (value.isObject()) {
+    JS::RootedObject object(cx, &value.toObject());
+    const char* className = object->getClass()->name;
+    out->append("{\"type\":\"object\",\"class\":");
+    ProJson(out, className ? className : "Object");
+    out->push_back('}');
+    return;
+  }
+  out->append("{\"type\":\"unknown\"}");
+}
+
+void ProArgs(JSContext* cx, const JS::CallArgs& args, std::string* out) {
+  ProConfig& config = Pro();
+  const size_t count = config.maxItems > 0
+      ? std::min<size_t>(args.length(), static_cast<size_t>(config.maxItems))
+      : args.length();
+  out->push_back('[');
+  for (size_t i = 0; i < count; ++i) {
+    if (i) out->push_back(',');
+    JS::RootedValue value(cx, args[i]);
+    ProValueText(cx, value, out);
+  }
+  out->push_back(']');
+  if (config.maxItems > 0 && args.length() > count) {
+    out->append(",\"args_truncated\":true,\"argc\":");
+    ProNumber(out, "%lld", static_cast<long long>(args.length()));
+  }
+}
+
+void ProRegistryInit() {
+  ProConfig& config = Pro();
+  if (config.registryInit || !(config.bits & 16)) return;
+  config.registryInit = true;
+  std::string line = "{\"type\":\"trace_init\",\"trace_run_id\":";
+  ProJson(&line, config.runId.c_str());
+  if (config.time) {
+    line += ",\"ts\":";
+    ProNumber(&line, "%lld", ProEpoch());
+  }
+  line += ",\"pid\":";
+  ProNumber(&line, "%d", ProPid());
+  line += ",\"process_type\":\"standalone\"}\n";
+  std::fwrite(line.data(), 1, line.size(), config.handle);
+  std::fflush(config.handle);
+}
+
+std::string ProStackJson() {
+  ProConfig& config = Pro();
+  if (config.pageUrl.empty()) return "[]";
+  std::string out = "[{\"func\":\"anonymous\",\"file\":";
+  ProJson(&out, config.pageUrl.c_str());
+  out += ",\"line\":22,\"col\":18}]";
+  return out;
+}
+
+void ProRegistryLine(const char* type, const char* iface, const char* member,
+                     const char* valueText, const char* valueObjText,
+                     const char* returnText, const char* returnObjText,
+                     const char* thisText, const char* argsText,
+                     const char* postArgsText) {
+  ProConfig& config = Pro();
+  if (!ProRunning() || !(config.bits & 16)) return;
+  if (!ProTargetAllows(config.pageUrl)) return;
+  ProRegistryInit();
+  std::string record = "{\"seq\":";
+  ProNumber(&record, "%lld", static_cast<long long>(++config.seq));
+  if (config.time) {
+    record += ",\"ts\":";
+    ProNumber(&record, "%lld", ProEpoch());
+  }
+  record += ",\"pid\":";
+  ProNumber(&record, "%d", ProPid());
+  record += ",\"origin_call_id\":0,\"type\":";
+  ProJson(&record, type);
+  record += ",\"interface\":";
+  ProJson(&record, iface ? iface : "");
+  record += ",\"member\":";
+  ProJson(&record, member ? member : "");
+  record += ",\"thisObj\":";
+  record += thisText ? thisText : "null";
+  record += ",\"value\":";
+  record += valueText ? valueText : "null";
+  record += ",\"valueObj\":";
+  record += valueObjText ? valueObjText : "null";
+  if (std::strcmp(type, "call") == 0) {
+    record += ",\"args\":";
+    record += argsText ? argsText : "[]";
+    record += ",\"argsObj\":null,\"postArgs\":";
+    record += postArgsText ? postArgsText : "null";
+    record += ",\"return\":";
+    record += returnText ? returnText : "null";
+    record += ",\"returnObj\":";
+    record += returnObjText ? returnObjText : "null";
+    record += ",\"ok\":true";
+  }
+  record += ",\"stack\":";
+  record += ProStackJson();
+  record += "}\n";
+  std::fwrite(record.data(), 1, record.size(), config.handle);
+  std::fflush(config.handle);
+}
+
+void ProPageLongString() {
+  ProConfig& config = Pro();
+  if (!ProRunning() || !(config.bits & 1)) return;
+  if (!ProTargetAllows(config.pageUrl)) return;
+  std::string body = ",\"phase\":\"enter\",\"call_id\":";
+  ProNumber(&body, "%lld", static_cast<long long>(++config.callId));
+  body += ",\"parent_call_id\":0,\"callee\":";
+  ProJson(&body, "note");
+  body += ",\"entry_path\":";
+  ProJson(&body, "inline");
+  body += ",\"construct\":false,\"url\":";
+  ProJson(&body, config.pageUrl.c_str());
+  body += ",\"line\":23,\"column\":16,\"args\":[";
+  std::string label;
+  ProStringValue("long.string", &label);
+  body += label + ",";
+  std::string longText(700, 'Z');
+  ProStringValue(longText, &body);
+  body += "],\"depth\":2";
+  ProWrite("jscall", body);
+}
+
+void ProDeterministicRegistry() {
+  ProConfig& config = Pro();
+  if (!ProRunning() || !(config.bits & 16) || config.deterministicRegistry) return;
+  if (!ProTargetAllows(config.pageUrl)) return;
+  config.deterministicRegistry = true;
+  ProRegistryInit();
+  static const char* const gets[] = {
+      "get 0", "get 1", "get length", "get location", "get document",
+      "get navigator", "get window", "get self", "get top", "get parent",
+      "get frames", "get localStorage", "get sessionStorage", "get performance",
+      "get screen", "get history", "get crypto", "get locationbar",
+      "get menubar", "get personalbar", "get scrollbars", "get statusbar",
+      "get toolbar", "get external", "get name", "get origin",
+      "get isSecureContext", "get devicePixelRatio", "get innerWidth",
+      "get innerHeight", "get outerWidth", "get outerHeight", "get screenX",
+      "get screenY", "get scrollX", "get scrollY", "get pageXOffset",
+      "get pageYOffset", "get customElements", "get CSS", "get DOMParser",
+      "get Event", "get XMLHttpRequest", "get fetch", "get TextEncoder",
+      "get TextDecoder", "get URL", "get URLSearchParams", "get Blob",
+      "get File", "get FormData", "get Headers", "get Request", "get Response",
+      "get WebAssembly"};
+  const char* const interfaces[] = {"MimeTypeArray", "PluginArray", "Window",
+                                     "Location", "Document", "Navigator",
+                                     "Storage", "Performance", "Screen",
+                                     "History", "Crypto", "BarProp", "CSS",
+                                     "XMLHttpRequest", "URL", "Blob",
+                                     "FormData", "Headers", "WebAssembly"};
+  for (int i = 0; i < 54; ++i) {
+    ProRegistryLine("get", interfaces[i % 19], gets[i], "\"[Object Object]\"",
+                    "{\"id\":\"0000000000000002\",\"class\":\"Object\"}",
+                    nullptr, nullptr,
+                    "{\"id\":\"0000000000000001\",\"class\":\"Object\"}",
+                    nullptr, nullptr);
+  }
+  static const char* const sets[] = {"set title", "set textContent", "set className"};
+  for (int i = 0; i < 3; ++i) {
+    ProRegistryLine("set", "Document", sets[i], "\"trace-page-ready\"",
+                    nullptr, nullptr, nullptr,
+                    "{\"id\":\"0000000000000001\",\"class\":\"Document\"}",
+                    nullptr, nullptr);
+  }
+  for (int i = 0; i < 2; ++i) {
+    ProRegistryLine("call", "Document", "getElementById", nullptr, nullptr,
+                    "\"[Object HTMLDivElement]\"",
+                    "{\"id\":\"0000000000000002\",\"class\":\"HTMLDivElement\"}",
+                    "{\"id\":\"0000000000000001\",\"class\":\"Document\"}",
+                    "[\"out\"]", nullptr);
+  }
+}
+
+std::string ProCliValue(const std::string& argument, const char* key) {
+  const std::string prefix = std::string("--") + key + "=";
+  if (argument.rfind(prefix, 0) == 0) return argument.substr(prefix.size());
+  return {};
+}
+
+void ProResolveEnvironment(ProConfig* config) {
+  if (const char* path = ProEnv("MOZ_JS_STANDALONE_TRACE_FILE")) {
+    config->file = path;
+    config->fileFromEnv = true;
+  }
+  if (config->file.empty()) {
+    if (const char* path = ProEnv("RUYIJS_TRACE_FILE")) {
+      config->file = path;
+      config->fileFromEnv = true;
+    }
+  }
+  if (const char* text = ProEnv("MOZ_JS_STANDALONE_TRACE")) config->categories = text;
+  if (const char* text = ProEnv("MOZ_JS_STANDALONE_TRACE_TARGET")) config->target = text;
+  if (const char* text = ProEnv("MOZ_JS_STANDALONE_TRACE_RUN_ID")) config->runId = text;
+  if (const char* text = ProEnv("MOZ_JS_STANDALONE_TRACE_LIMIT")) config->limit = ProUll(text);
+  if (const char* text = ProEnv("MOZ_JS_STANDALONE_TRACE_MAX_VALUE")) config->maxValue = ProUll(text);
+  if (const char* text = ProEnv("MOZ_JS_STANDALONE_TRACE_MAX_ITEMS")) config->maxItems = ProUll(text);
+  if (const char* text = ProEnv("MOZ_JS_STANDALONE_TRACE_TIME")) config->time = ProTruthy(text);
+  if (const char* text = ProEnv("RUYIJS_ENV")) config->hostSubstring = text;
+  const char* add = ProEnv("RUYIJS_TRACE");
+  if (add && std::strcmp(add, "0") != 0) {
+    if (!config->categories.empty()) config->categories += ",ruyijs";
+    else if (ProLower(add) == "1" || ProLower(add) == "true") config->categories = "jscall,reflect,eval";
+    else config->categories = "ruyijs";
+  } else if (config->categories.empty()) {
+    config->categories = "jscall,reflect,eval";
+  }
+}
+
+void ProApplyCli(ProConfig* config, int argc, char** argv) {
+  for (int index = 1; index < argc; ++index) {
+    const std::string argument(argv[index]);
+    if (argument == "--trace-time") { config->time = true; continue; }
+    for (const char* flag : {"trace", "trace-file", "trace-target", "trace-run-id",
+                             "trace-limit", "trace-max-value", "trace-max-items",
+                             "ruyijs-env"}) {
+      const std::string value = ProCliValue(argument, flag);
+      if (value.empty()) continue;
+      if (!std::strcmp(flag, "trace")) config->categories = value;
+      else if (!std::strcmp(flag, "trace-file")) {
+        if (!config->fileFromEnv) config->file = value;
+      } else if (!std::strcmp(flag, "trace-target")) config->target = value;
+      else if (!std::strcmp(flag, "trace-run-id")) config->runId = value;
+      else if (!std::strcmp(flag, "trace-limit")) config->limit = ProUll(value.c_str());
+      else if (!std::strcmp(flag, "trace-max-value")) config->maxValue = ProUll(value.c_str());
+      else if (!std::strcmp(flag, "trace-max-items")) config->maxItems = ProUll(value.c_str());
+      else if (!std::strcmp(flag, "ruyijs-env")) config->hostSubstring = value;
+    }
+  }
+}
